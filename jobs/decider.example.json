{
  "name": "decider",
  "description": "Example job: process runtime + ${paths.*}；启动参数在 extra_args",
  "gpus_per_node": 4,
  "runtime": "process",
  "model": "decider-2b",
  "python": "${paths.python}",
  "script": "${paths.model_root}/Mapika/start_model.py",
  "extra_args": ["--base-port", "30000"],
  "actions": ["start", "stop", "restart", "status", "wait"]
}

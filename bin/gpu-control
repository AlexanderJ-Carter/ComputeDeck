#!/usr/bin/env python3
"""gpu-control 统一 CLI：多节点 GPU 控制面（Ansible / Job / Gateway / 工具栈）。"""

from __future__ import annotations

import argparse
import json
import os
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from paths import (  # noqa: E402
    ANSIBLE,
    INVENTORY_FILE,
    PROJECT_DIR,
    RESOURCES_FILE,
    STATE_DIR,
    VENV_PYTHON,
    ansible_cmd,
    cluster_file,
    ensure_runtime_dirs,
    expand_path,
    job_file,
    list_job_files,
    nodes_file,
)
from node_paths import group_nodes_by_job, load_nodes_data, resolve_job  # noqa: E402
from process_util import pid_alive, pid_cmdline  # noqa: E402
from state_util import (  # noqa: E402
    atomic_write_json as _atomic_write_json,
    read_json as _read_json_state,
    update_json as _update_json_state,
)
from jobs_util import (  # noqa: E402
    default_job_name,
    install_job_template,
    install_recommended_templates,
    list_job_templates,
    load_job_summaries,
)

LEASES_FILE = STATE_DIR / "leases.json"
QUEUE_FILE = STATE_DIR / "queue.json"
PROBE_FILE = STATE_DIR / "probe.json"
NODE_STATE_FILE = STATE_DIR / "node_state.json"
ENDPOINTS_FILE = STATE_DIR / "endpoints.json"
INVENTORY = INVENTORY_FILE


def die(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def ensure_runtime() -> None:
    if not ANSIBLE.is_file():
        die(
            f"未找到 Ansible：{ANSIBLE}\n"
            "请在 Control 节点创建 .venv 并安装 ansible。"
        )
    ensure_runtime_dirs()


def load_job(name: str) -> dict:
    path = job_file(name)
    if path is None:
        available = ", ".join(p.stem for p in list_job_files()) or "(none)"
        die(f"未知 Job '{name}'。可用：{available}")
    job = json.loads(path.read_text(encoding="utf-8"))
    for key in ("python", "script"):
        if key in job and isinstance(job[key], str):
            job[key] = expand_path(job[key])
    return job


def load_cluster() -> dict:
    path = cluster_file()
    if not path.is_file():
        return {}
    data = json.loads(path.read_text(encoding="utf-8"))
    api = data.get("api") or {}
    if api.get("api_key_file"):
        api["api_key_file"] = expand_path(api["api_key_file"])
        data["api"] = api
    return data


def select_nodes_cli_args(gpus: int) -> list[str]:
    """按集群调度偏好组装 ``select_nodes.py`` 参数。"""
    args = ["--gpus", str(gpus), "--json"]
    scheduling = (load_cluster().get("scheduling") or {})
    prefer = scheduling.get("prefer_labels") or []
    avoid = scheduling.get("avoid_labels") or []
    if prefer:
        args.extend(["--prefer-labels", ",".join(prefer)])
    if avoid:
        args.extend(["--avoid-labels", ",".join(avoid)])
    return args


def resolve_unit_gpus(explicit: int | None) -> int:
    """解析调度所需 GPU 总数：显式参数优先，否则 ``cluster.scheduling.unit_gpus``。

    :param explicit: CLI ``--gpus``；未传为 ``None``。
    :returns: 正整数 GPU 总数。
    :raises SystemExit: 两者皆缺或非法。
    """
    if explicit is not None:
        if int(explicit) < 1:
            die("--gpus 必须为正整数")
        return int(explicit)
    raw = (load_cluster().get("scheduling") or {}).get("unit_gpus")
    if raw is None or raw == "":
        die("需要 --gpus，或在 cluster.scheduling.unit_gpus 中配置")
    value = int(raw)
    if value < 1:
        die("cluster.scheduling.unit_gpus 必须为正整数")
    return value


def resolve_node_gpu_count(
    name: str,
    meta: dict | None = None,
    *,
    defaults: dict | None = None,
    live: dict | None = None,
) -> int | None:
    """解析单节点 GPU 数：节点配置 → defaults → 实采；不发明数字。

    :returns: GPU 数；皆无则 ``None``。
    """
    meta = meta or {}
    defaults = defaults or {}
    if meta.get("gpus_per_node") is not None and meta.get("gpus_per_node") != "":
        return int(meta["gpus_per_node"])
    if defaults.get("gpus_per_node") is not None and defaults.get("gpus_per_node") != "":
        return int(defaults["gpus_per_node"])
    if live:
        count = live.get("gpu_count") or len(live.get("gpus") or [])
        if count:
            return int(count)
    return None


def list_jobs() -> list[dict]:
    jobs = []
    for path in list_job_files():
        job = json.loads(path.read_text(encoding="utf-8"))
        for key in ("python", "script"):
            if key in job and isinstance(job[key], str):
                job[key] = expand_path(job[key])
        jobs.append(job)
    return jobs


def load_leases() -> dict:
    return _read_json_state(LEASES_FILE, {"leases": []})


def mutate_leases(mutator) -> dict:
    """在 flock 下读改写 ``leases.json``。"""
    return _update_json_state(LEASES_FILE, mutator, default={"leases": []})


def load_resources() -> dict:
    if not RESOURCES_FILE.is_file():
        return {}
    return json.loads(RESOURCES_FILE.read_text(encoding="utf-8"))


def load_queue() -> dict:
    return _read_json_state(QUEUE_FILE, {"workloads": []})


def mutate_queue(mutator) -> dict:
    """在 flock 下读改写 ``queue.json``。"""
    return _update_json_state(QUEUE_FILE, mutator, default={"workloads": []})


def patch_queue_workload(workload_id: str, **fields) -> dict | None:
    """按 id 更新一条队列项；返回更新后的条目，未找到则 ``None``。"""
    found: dict = {}

    def mutate(data: dict) -> None:
        for wl in data.setdefault("workloads", []):
            if wl.get("id") == workload_id:
                wl.update(fields)
                found.update(wl)
                return

    mutate_queue(mutate)
    return found or None


def now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def inventory_hosts() -> dict[str, str]:
    hosts: dict[str, str] = {}
    in_workers = False
    for line in INVENTORY.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            in_workers = line == "[gpu_workers]"
            continue
        if not in_workers:
            continue
        parts = line.split()
        name = parts[0]
        host = name
        for part in parts[1:]:
            if part.startswith("ansible_host="):
                host = part.split("=", 1)[1]
        hosts[name] = host
    return hosts


def ansible_env(*, quiet: bool = False) -> dict[str, str]:
    env = os.environ.copy()
    if quiet:
        env["ANSIBLE_STDOUT_CALLBACK"] = "minimal"
        env["ANSIBLE_DISPLAY_SKIPPED_HOSTS"] = "false"
        env["ANSIBLE_DISPLAY_OK_HOSTS"] = "true"
    return env


def ansible_playbook(
    playbook: str,
    *,
    extra: dict | None = None,
    limit: str | None = None,
    quiet: bool = False,
    capture: bool = False,
) -> int:
    ensure_runtime()
    cmd = ansible_cmd("-i", str(INVENTORY), str(PROJECT_DIR / "playbooks" / playbook))
    if limit:
        cmd.extend(["--limit", limit])
    if extra:
        cmd.extend(["-e", json.dumps(extra, ensure_ascii=False)])
    if not quiet and not capture:
        print("+", " ".join(cmd))
    if capture:
        proc = subprocess.run(
            cmd,
            cwd=PROJECT_DIR,
            env=ansible_env(quiet=True),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        return proc.returncode
    return subprocess.call(cmd, cwd=PROJECT_DIR, env=ansible_env(quiet=quiet))


def run_python(script: str, *args: str) -> subprocess.CompletedProcess[str]:
    ensure_runtime()
    return subprocess.run(
        [str(VENV_PYTHON), str(PROJECT_DIR / "scripts" / script), *args],
        cwd=PROJECT_DIR,
        check=False,
        text=True,
        capture_output=False,
    )


def run_python_capture(script: str, *args: str) -> subprocess.CompletedProcess[str]:
    ensure_runtime()
    return subprocess.run(
        [str(VENV_PYTHON), str(PROJECT_DIR / "scripts" / script), *args],
        cwd=PROJECT_DIR,
        check=False,
        text=True,
        capture_output=True,
    )


def resolve_limit(node: str | None, nodes: str | None) -> str | None:
    # --node wins when both appear (exec defaults --nodes=all).
    if node:
        return node
    if nodes and nodes != "all":
        return nodes
    return None


def load_nodes_registry() -> dict:
    path = nodes_file()
    if path.is_file():
        data = json.loads(path.read_text(encoding="utf-8"))
        defaults = data.setdefault("defaults", {})
        if defaults.get("ansible_ssh_private_key_file"):
            defaults["ansible_ssh_private_key_file"] = expand_path(
                defaults["ansible_ssh_private_key_file"]
            )
        return data
    # Fallback: synthesize from inventory.ini
    return {
        "defaults": {},
        "nodes": {
            name: {"ansible_host": host}
            for name, host in inventory_hosts().items()
        },
    }


def save_nodes_registry(data: dict) -> None:
    path = nodes_file(write=True)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(data, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    # keep root symlink/file in sync for older tools
    root = PROJECT_DIR / "nodes.json"
    if root.is_symlink() or not root.exists():
        if root.exists() or root.is_symlink():
            root.unlink()
        root.symlink_to(path.relative_to(PROJECT_DIR))
    run_python("render_inventory.py")


def load_node_state() -> dict:
    return _read_json_state(NODE_STATE_FILE, {"cordoned": {}})


def save_node_state(data: dict) -> None:
    _atomic_write_json(NODE_STATE_FILE, data)


def inventory_nodes() -> list[str]:
    registry = load_nodes_registry()
    names = sorted(registry.get("nodes", {}).keys())
    if names:
        return names
    nodes: list[str] = []
    in_workers = False
    for line in INVENTORY.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            in_workers = line == "[gpu_workers]"
            continue
        if not in_workers:
            continue
        name = line.split()[0]
        if name.startswith("ansible_"):
            continue
        nodes.append(name)
    return nodes


def refresh_resources(*, quiet: bool = False) -> int:
    """采集 GPU 快照并解析。

    单台节点不可达时 Ansible 会返回非零，但其他节点的快照仍然有效：
    此时继续解析，让 ``resources.json`` 更新可达节点，并把未采集到的节点
    交给 ``state/resources_health.json`` 标记。
    """
    code = ansible_playbook("collect-resources.yml", quiet=quiet)
    parsed = run_python("parse_resources.py")
    if parsed.returncode != 0:
        return parsed.returncode
    if code != 0 and not quiet:
        print(
            "warn: 部分节点采集失败；已解析可用快照，详见 state/resources_health.json",
            file=sys.stderr,
        )
    return 0


def acquire_lease(
    job: str,
    nodes: list[str],
    gpus: int,
    note: str = "",
    owner: str | None = None,
) -> dict:
    created: dict = {}

    def mutate(data: dict) -> None:
        leases: list[dict] = data.setdefault("leases", [])
        occupied = {n for lease in leases for n in lease.get("nodes", [])}
        conflict = sorted(set(nodes) & occupied)
        if conflict:
            die(f"节点已被租用：{', '.join(conflict)}")
        lease = {
            "id": f"lease-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S%f')}",
            "job": job,
            "nodes": nodes,
            "gpus": gpus,
            "owner": owner or os.environ.get("USER", "unknown"),
            "created_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "note": note,
        }
        leases.append(lease)
        created.update(lease)

    mutate_leases(mutate)
    return created


def release_lease_nodes(nodes: list[str]) -> int:
    dropped = {"count": 0}

    def mutate(data: dict) -> None:
        leases: list[dict] = data.setdefault("leases", [])
        drop = set(nodes)
        before = len(leases)
        leases[:] = [lease for lease in leases if not drop.intersection(lease.get("nodes", []))]
        dropped["count"] = before - len(leases)

    mutate_leases(mutate)
    return int(dropped["count"])


def release_lease_id(lease_id: str) -> int:
    dropped = {"count": 0}

    def mutate(data: dict) -> None:
        leases: list[dict] = data.setdefault("leases", [])
        before = len(leases)
        leases[:] = [lease for lease in leases if lease.get("id") != lease_id]
        dropped["count"] = before - len(leases)

    mutate_leases(mutate)
    return int(dropped["count"])


def job_manager_extra(job: dict, action: str, *, extra_args: list[str] | None = None) -> dict:
    runtime = job.get("runtime") or "process"
    args = list(extra_args if extra_args is not None else job.get("extra_args") or [])
    gpus_per_node = int(job.get("gpus_per_node") or 1)
    nproc = int(job.get("nproc_per_node") or gpus_per_node)
    env = dict(job.get("env") or {})
    if job.get("name") and "GPU_CONTROL_JOB_NAME" not in env:
        env["GPU_CONTROL_JOB_NAME"] = str(job["name"])
    payload = {
        "job_action": action,
        "runtime": runtime,
        "job_python": job.get("python") or "python3",
        "job_script": job.get("script") or "",
        "job_extra_args": args,
        "job_env": env,
        "job_kind": job.get("kind") or "service",
        "distributed": bool(job.get("distributed")),
        "nproc_per_node": nproc,
        "master_port": int(job.get("master_port") or 29500),
    }
    if runtime == "docker":
        docker = job.get("docker") or {}
        name = docker.get("name") or f"gpu-control-{job.get('name', 'job')}"
        payload.update(
            {
                "docker_image": docker.get("image") or "",
                "docker_name": name,
                "docker_gpus": docker.get("gpus") or "all",
                "docker_ports": docker.get("ports") or [],
                "docker_volumes": docker.get("volumes") or [],
                "docker_command": docker.get("command") or [],
                "docker_env": docker.get("env") or {},
            }
        )
    return payload


def target_worker_nodes(limit: str | None) -> list[str]:
    hosts = list(inventory_hosts().keys())
    if not limit:
        return hosts
    wanted = {n.strip() for n in limit.split(",") if n.strip()}
    return [h for h in hosts if h in wanted]


def run_job_on_nodes(
    job: dict,
    action: str,
    *,
    limit: str | None,
    quiet: bool = False,
    extra_args: list[str] | None = None,
) -> int:
    nodes = target_worker_nodes(limit)
    if not nodes:
        die("没有可操作的 gpu_workers 节点")
    if job.get("runtime") == "docker" and not (job.get("docker") or {}).get("image"):
        die("runtime=docker 时需要 job.docker.image")
    if (job.get("runtime") or "process") == "process":
        if not job.get("python") or not job.get("script"):
            die("runtime=process 时需要 job.python 与 job.script")

    data = load_nodes_data()
    code = 0
    for group_nodes, resolved in group_nodes_by_job(job, nodes, data):
        if extra_args is not None:
            resolved = dict(resolved)
            resolved["extra_args"] = list(extra_args)
        rc = ansible_playbook(
            "manage-job.yml",
            limit=",".join(group_nodes),
            extra=job_manager_extra(resolved, action, extra_args=extra_args),
            quiet=quiet,
        )
        if rc != 0:
            code = rc
    return code


def cmd_jobs(args: argparse.Namespace) -> int:
    action = getattr(args, "jobs_action", None) or "list"
    if action == "logs":
        return cmd_jobs_logs(args)
    if action == "templates":
        rows = list_job_templates()
        if getattr(args, "json", False):
            print(json.dumps({"templates": rows}, ensure_ascii=False, indent=2))
            return 0
        if not rows:
            print("No templates under config/examples or jobs/")
            return 0
        for t in rows:
            mark = "installed" if t.get("installed") else "available"
            rec = " ★" if t.get("recommended") else ""
            cat = t.get("category") or ""
            print(
                f"{t['id']}: {t.get('description', '')} "
                f"[{cat}/{t.get('runtime')}] ({mark}){rec}"
            )
        return 0
    if action == "install":
        if getattr(args, "recommended", False):
            if args.template or args.name:
                die("jobs install --recommended 不可与模板 id / --name 同用")
            result = install_recommended_templates(force=bool(getattr(args, "force", False)))
            print(json.dumps(result, ensure_ascii=False, indent=2))
            return 0
        template = args.template
        if not template:
            die(
                "jobs install 需要模板 id，如: gpu-control jobs install http-serve\n"
                "或一键推荐包: gpu-control jobs install --recommended"
            )
        try:
            result = install_job_template(template, name=args.name)
        except (FileNotFoundError, ValueError, OSError) as exc:
            die(str(exc))
        print(json.dumps(result, ensure_ascii=False, indent=2))
        return 0

    jobs = load_job_summaries()
    if getattr(args, "json", False):
        print(json.dumps({
            "jobs": jobs,
            "default_job": default_job_name(),
        }, ensure_ascii=False, indent=2))
        return 0
    if not jobs:
        print(
            "No jobs registered. Try:\n"
            "  gpu-control jobs install --recommended\n"
            "  gpu-control jobs install shell-job"
        )
        return 0
    print(f"default_job={default_job_name()}")
    for job in jobs:
        dist = " dist" if job.get("distributed") else ""
        kind = job.get("kind") or "service"
        print(
            f"{job['name']}: {job.get('description', '')} "
            f"(kind={kind} gpus={job.get('gpus_per_node', '?')} "
            f"runtime={job.get('runtime')}{dist} source={job.get('source')})"
        )
    return 0


def cmd_jobs_logs(args: argparse.Namespace) -> int:
    """在选定节点上跟踪 Job 运行时日志。"""
    name = getattr(args, "template", None) or getattr(args, "name", None)
    if not name:
        die("jobs logs 需要 Job 名，如: gpu-control jobs logs sft")
    job = load_job(name)
    data = load_nodes_data()
    nodes = target_worker_nodes(getattr(args, "nodes", None) or getattr(args, "node", None))
    if not nodes:
        die("没有可操作的 gpu_workers 节点")
    lines = max(1, int(getattr(args, "lines", 120) or 120))
    code = 0
    for node in nodes:
        resolved = resolve_job(job, node, data)
        env = resolved.get("env") or {}
        runtime = env.get("GPU_CONTROL_JOB_RUNTIME") or f"/tmp/gpu-control-jobs/{job.get('name') or name}"
        log_path = env.get("GPU_CONTROL_JOB_LOG") or f"{runtime}/job.log"
        command = (
            f"tail -n {lines} {shlex.quote(str(log_path))} 2>/dev/null "
            f"|| echo 'no log: {log_path}'"
        )
        exec_dir = STATE_DIR / "exec"
        if exec_dir.is_dir():
            for stale in exec_dir.glob("*.json"):
                stale.unlink()
        rc = ansible_playbook(
            "exec.yml",
            limit=node,
            extra={"remote_command": command},
            quiet=True,
            capture=True,
        )
        collect = run_python("collect_exec.py")
        code = max(code, rc, collect.returncode)
    return code


def cmd_job_action(args: argparse.Namespace) -> int:
    job = load_job(args.job)
    action = args.action
    allowed = job.get("actions", ["start", "stop", "restart", "status", "wait"])
    if action not in allowed:
        die(f"Job '{job['name']}' 不支持动作 '{action}'")

    limit = resolve_limit(getattr(args, "node", None), getattr(args, "nodes", None))
    quiet = bool(getattr(args, "quiet", False))
    override_args = getattr(args, "extra_args", None)
    if action in {"start", "restart"}:
        refuse_cordoned(
            target_worker_nodes(limit),
            allow_cordoned=bool(getattr(args, "allow_cordoned", False)),
        )
    code = run_job_on_nodes(
        job,
        action,
        limit=limit,
        quiet=quiet,
        extra_args=override_args,
    )
    if action == "stop" and code == 0:
        nodes = target_worker_nodes(limit)
        released = release_lease_nodes(nodes)
        if released:
            print(f"Released {released} lease(s) covering: {', '.join(nodes)}")
    return code


def cmd_gpu(args: argparse.Namespace) -> int:
    quiet = bool(getattr(args, "quiet", False))
    if args.refresh or args.action == "refresh":
        return refresh_resources(quiet=quiet)

    if args.action in {None, "list"}:
        return ansible_playbook(
            "check-gpus.yml",
            limit=resolve_limit(args.node, args.nodes),
            quiet=quiet,
        )

    die(f"未知 gpu 动作：{args.action}")
    return 1


def cmd_plan(args: argparse.Namespace) -> int:
    quiet = bool(getattr(args, "quiet", False))
    code = refresh_resources(quiet=quiet)
    if code != 0:
        return code
    select_args = select_nodes_cli_args(resolve_unit_gpus(args.gpus))
    # human-readable: drop --json
    human = [a for a in select_args if a != "--json"]
    return run_python("select_nodes.py", *human).returncode


def cmd_status_default(args: argparse.Namespace) -> int:
    args.action = "status"
    if not args.job:
        args.job = default_job_name()
        if not args.job:
            die("没有已注册 Job。请复制 config/examples/*.example.json → config/local/jobs/")
    return cmd_job_action(args)


def cmd_overview(args: argparse.Namespace) -> int:
    """单屏集群总览：GPU + lease，可选 Job 就绪状态。"""
    quiet = True
    if not args.cached:
        code = refresh_resources(quiet=quiet)
        if code != 0:
            return code

    resources = load_resources()
    leases = load_leases().get("leases", [])
    lease_by_node = {
        node: lease
        for lease in leases
        for node in lease.get("nodes", [])
    }

    import liveness

    cluster = load_cluster()
    live = liveness.cluster_view(
        node_names=inventory_nodes(),
        resources=resources,
        ssh_quality=_read_json_state(STATE_DIR / "ssh_quality.json", {}),
        host_metrics=_read_json_state(STATE_DIR / "host_metrics.json", {}),
        probe=_read_json_state(PROBE_FILE, {}),
        endpoint_health=_read_json_state(STATE_DIR / "endpoint_health.json", {}),
        persisted=liveness.read_snapshot(STATE_DIR / "liveness.json"),
        cluster=cluster,
    )
    live_nodes = live.get("nodes") or {}
    summary = live.get("summary") or {}

    cordoned = load_node_state().get("cordoned", {})
    print("=== Cluster Overview ===")
    print(
        "nodes: "
        f"online={summary.get('online', 0)} degraded={summary.get('degraded', 0)} "
        f"offline={summary.get('offline', 0)} unknown={summary.get('unknown', 0)} "
        f"snapshot_stale={summary.get('snapshot_stale_count', 0)}"
    )
    print(
        f"{'NODE':<12} {'FREE':>4} {'USED':>4} {'TOTAL':>5}  "
        f"{'STATE':<10} {'LAST SEEN':<10} {'LEASE':<24} GPU MEM/UTIL"
    )
    for name in inventory_nodes():
        node = resources.get(name, {})
        gpus = node.get("gpus", [])
        free = node.get("free_count", sum(1 for g in gpus if g.get("status") == "free"))
        used = node.get("occupied_count", sum(1 for g in gpus if g.get("status") == "occupied"))
        total = node.get("gpu_count", len(gpus))
        lease = lease_by_node.get(name)
        lease_text = f"{lease['job']}({lease['id']})" if lease else "-"
        live_node = live_nodes.get(name) or {}
        live_state = str(live_node.get("state") or "unknown")
        snapshot = live_node.get("snapshot") or {}
        if live_state == "offline":
            state = "offline"
        elif live_state == "degraded":
            state = "degraded"
        elif live_state == "unknown":
            state = "unknown"
        elif snapshot.get("stale"):
            state = "stale"
        elif name in cordoned:
            state = "cordoned"
        else:
            state = "ready"
        last_seen = live_node.get("last_seen_age_sec")
        last_seen_text = liveness.format_age(last_seen) if last_seen is not None else "-"
        mem = ",".join(str(g.get("memory_used_mib", "?")) for g in gpus) or "-"
        util = ",".join(str(g.get("utilization_percent", "?")) for g in gpus) or "-"
        suffix = ""
        if snapshot.get("stale"):
            suffix = f" [snapshot {snapshot.get('age_text') or '-'} old]"
        print(
            f"{name:<12} {free:>4} {used:>4} {total:>5}  "
            f"{state:<10} {last_seen_text:<10} {lease_text:<24} mem={mem} util={util}{suffix}"
        )

    if leases:
        print("\n=== Active Leases ===")
        for lease in leases:
            print(
                f"- {lease['id']}: job={lease['job']} nodes={','.join(lease['nodes'])} "
                f"gpus={lease['gpus']} owner={lease.get('owner', '-')} note={lease.get('note') or '-'}"
            )
    else:
        print("\nActive leases: (none)")

    if args.job:
        print(f"\n=== Job status: {args.job} ===")
        job = load_job(args.job)
        return run_job_on_nodes(job, "status", limit=None, quiet=False)
    return 0


def leases_by_node() -> dict[str, dict]:
    """节点名 → 当前租约条目。"""
    mapping: dict[str, dict] = {}
    for lease in load_leases().get("leases") or []:
        for node in lease.get("nodes") or []:
            mapping[str(node)] = lease
    return mapping


def assert_deploy_leases(
    selected: list[str],
    job_name: str,
    *,
    force: bool = False,
) -> None:
    """部署前检查租约：同名 Job 可重入；异主租约默认拒绝。

    :param force: 为真时释放异主租约后继续。
    """
    by_node = leases_by_node()
    foreign_nodes: list[str] = []
    details: list[str] = []
    for node in selected:
        lease = by_node.get(node)
        if not lease:
            continue
        holder = str(lease.get("job") or "")
        if holder == job_name:
            continue
        foreign_nodes.append(node)
        details.append(f"{node}→{holder or '?'}({lease.get('id') or '-'})")
    if not foreign_nodes:
        return
    if not force:
        die(
            "节点已有异主租约："
            + ", ".join(details)
            + "。先 free/lease release，或加 --force 覆盖"
        )
    released = release_lease_nodes(foreign_nodes)
    print(f"--force：已释放异主租约 {released} 条（节点 {','.join(foreign_nodes)}）")


def deploy_job(
    job_name: str,
    *,
    gpus: int,
    nodes: str | None = None,
    restart: bool = False,
    no_wait: bool = False,
    note: str = "",
    quiet: bool = False,
    selected: list[str] | None = None,
    allow_cordoned: bool = False,
    force: bool = False,
) -> tuple[int, list[str]]:
    """部署 Job。

    :returns: ``(exit_code, selected_nodes)``。
    """
    job = load_job(job_name)

    if selected is None:
        if nodes:
            if nodes == "all":
                selected = inventory_nodes()
            else:
                selected = [n.strip() for n in nodes.split(",") if n.strip()]
        else:
            code = refresh_resources(quiet=quiet)
            if code != 0:
                return code, []
            result = run_python_capture(
                "select_nodes.py", *select_nodes_cli_args(gpus)
            )
            print(result.stdout, end="")
            if result.stderr:
                print(result.stderr, end="", file=sys.stderr)
            if result.returncode != 0:
                return result.returncode, []
            payload = json.loads(result.stdout.strip().splitlines()[-1])
            selected = payload["selected"]

    if not selected:
        return 1, []

    refuse_cordoned(selected, allow_cordoned=allow_cordoned)
    assert_deploy_leases(selected, job["name"], force=force)
    limit = ",".join(selected)
    print(f"Deploying job={job['name']} nodes={limit}")

    if restart:
        code = run_job_on_nodes(job, "stop", limit=limit, quiet=quiet)
        if code != 0:
            return code, selected

    code = run_job_on_nodes(job, "start", limit=limit, quiet=quiet)
    if code != 0:
        return code, selected

    if not no_wait:
        code = run_job_on_nodes(job, "wait", limit=limit, quiet=quiet)
        if code != 0:
            return code, selected

    # Whole nodes are allocated by deploy; use the job's per-node GPU count
    # (not a hard-coded 4) when a node list was supplied.
    per_node_gpus = int(job.get("gpus_per_node") or 1)
    by_node = leases_by_node()
    to_lease = [
        n
        for n in selected
        if not by_node.get(n) or str(by_node[n].get("job") or "") != job["name"]
    ]
    if to_lease:
        # 同 Job 已占节点不重复登记；剩余节点登记一条合租约。
        if set(to_lease) == set(selected) and not nodes:
            lease_gpus = gpus
        else:
            lease_gpus = len(to_lease) * per_node_gpus
        lease = acquire_lease(
            job["name"],
            to_lease,
            gpus=lease_gpus,
            note=note or "deploy",
        )
        print("Lease acquired:")
        print(json.dumps(lease, ensure_ascii=False, indent=2))
    else:
        print("Nodes already leased by this job; skipped acquire")
    print(f"Deploy done: {job['name']} on {limit}")
    return 0, selected


def cmd_deploy(args: argparse.Namespace) -> int:
    code, _selected = deploy_job(
        args.job,
        gpus=resolve_unit_gpus(args.gpus) if not args.nodes else (args.gpus or 0),
        nodes=args.nodes,
        restart=args.restart,
        no_wait=args.no_wait,
        note=args.note,
        quiet=bool(args.quiet),
        allow_cordoned=bool(getattr(args, "allow_cordoned", False)),
        force=bool(getattr(args, "force", False)),
    )
    if code != 0 and not _selected:
        die("未选择部署节点")
    return code

def cmd_exec(args: argparse.Namespace) -> int:
    parts = list(args.command or [])
    if parts and parts[0] == "--":
        parts = parts[1:]
    command = " ".join(parts) if isinstance(parts, list) else str(parts)
    if not command.strip():
        die("exec 需要远程命令")
    exec_dir = STATE_DIR / "exec"
    if exec_dir.is_dir():
        for stale in exec_dir.glob("*.json"):
            stale.unlink()
    code = ansible_playbook(
        "exec.yml",
        limit=resolve_limit(args.node, args.nodes),
        extra={"remote_command": command},
        quiet=bool(args.quiet),
    )
    collect = run_python("collect_exec.py")
    if collect.returncode != 0 and code == 0:
        return collect.returncode
    return code


def _pid_looks_like_ui(pid: int) -> bool:
    """根据 cmdline 判断 PID 是否仍是 UI，避免 PID 复用误判。"""
    text = pid_cmdline(pid)
    return "web/server.py" in text or "gpu-control" in text and " ui" in text


def _pid_looks_like_watchdog(pid: int) -> bool:
    return "watchdog.py" in pid_cmdline(pid)


def cmd_ui(args: argparse.Namespace) -> int:
    """在 Control 节点启动本地集群 Web 控制台。"""
    ensure_runtime()
    server = PROJECT_DIR / "web" / "server.py"
    if not server.is_file():
        die(f"缺少 UI 服务脚本：{server}")
    control = (load_cluster().get("control") or {})
    host = args.host or control.get("ui_host") or "127.0.0.1"
    port = int(args.port or control.get("ui_port") or 8787)
    env = os.environ.copy()
    env["GPU_CONTROL_UI_HOST"] = host
    env["GPU_CONTROL_UI_PORT"] = str(port)
    url = f"http://{host}:{port}"
    cmd = [str(VENV_PYTHON), str(server)]

    if args.background:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        pid_file = STATE_DIR / "ui.pid"
        log_file = STATE_DIR / "ui.log"
        if pid_file.is_file():
            old = pid_file.read_text().strip()
            if old.isdigit() and pid_alive(int(old)) and _pid_looks_like_ui(int(old)):
                print(f"UI already running pid={old} log={log_file}")
                print(f"Open {url} (or SSH tunnel to localhost:{port})")
                return 0
            pid_file.unlink(missing_ok=True)
        with log_file.open("a", encoding="utf-8") as log:
            proc = subprocess.Popen(
                cmd,
                cwd=PROJECT_DIR,
                env=env,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        pid_file.write_text(f"{proc.pid}\n", encoding="utf-8")
        print(f"UI started pid={proc.pid} log={log_file}")
        print(f"Open {url} (or: ssh -L {port}:127.0.0.1:{port} <control>)")
        return 0

    print(f"Starting UI at {url}")
    print(f"远程访问：ssh -L {port}:127.0.0.1:{port} <control>")
    return subprocess.call(cmd, cwd=PROJECT_DIR, env=env)


def cmd_probe(args: argparse.Namespace) -> int:
    """探测 GPU 节点间 TCP 互通（分布式就绪检查）。"""
    ensure_runtime()
    peers = inventory_hosts()
    if len(peers) < 2:
        die("探测互通至少需要 inventory 中 2 个节点")
    ansible_playbook(
        "probe-network.yml",
        extra={
            "peer_map": peers,
            "probe_port": args.port,
            "probe_timeout": args.timeout,
        },
        quiet=bool(args.quiet),
    )
    # 部分节点不可达时仍合并其他节点写出的 probe 文件，避免整张矩阵冻结。
    merged = run_python("merge_probe.py").returncode
    if merged != 0:
        return merged
    return 0


def cordoned_names() -> set[str]:
    return set((load_node_state().get("cordoned") or {}).keys())


def filter_schedulable(nodes: list[str], *, allow_cordoned: bool = False) -> list[str]:
    if allow_cordoned:
        return list(nodes)
    blocked = cordoned_names()
    return [n for n in nodes if n not in blocked]


def refuse_cordoned(nodes: list[str], *, allow_cordoned: bool = False) -> None:
    if allow_cordoned:
        return
    blocked = sorted(set(nodes) & cordoned_names())
    if blocked:
        die(
            "节点已隔离（cordon），调度/启动已拒绝: "
            + ", ".join(blocked)
            + "\n取消隔离: gpu-control node uncordon <name>"
            + "\n强制操作: 加 --allow-cordoned"
        )


def gpu_occupancy(node: str) -> dict:
    resources = load_resources()
    info = resources.get(node) or {}
    gpus = info.get("gpus") or []
    return {
        "node": node,
        "free": int(info.get("free_count", sum(1 for g in gpus if g.get("status") == "free"))),
        "occupied": int(
            info.get("occupied_count", sum(1 for g in gpus if g.get("status") == "occupied"))
        ),
        "total": int(info.get("gpu_count", len(gpus))),
        "processes": [
            {
                "gpu": g.get("index"),
                "pid": p.get("pid"),
                "name": p.get("name"),
                "memory_mib": p.get("memory_mib"),
            }
            for g in gpus
            for p in (g.get("processes") or [])
        ],
    }


LIST_GPU_PROCS_CMD = (
    "echo HOST=$(hostname); "
    "nvidia-smi --query-gpu=index,uuid,memory.used,utilization.gpu "
    "--format=csv,noheader,nounits 2>/dev/null | sed 's/^/GPU,/'; "
    "echo ---; "
    "nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_gpu_memory "
    "--format=csv,noheader,nounits 2>/dev/null | sed 's/^/PROC,/'; "
    "echo ---; "
    "nvidia-smi --query-compute-apps=pid,process_name,used_gpu_memory "
    "--format=csv 2>/dev/null || echo NO_COMPUTE_APPS"
)


def build_kill_gpu_cmd(
    *,
    pids: list[int] | None = None,
    match: str | None = None,
    signal: str = "TERM",
) -> str:
    sig = "9" if signal.upper() in {"KILL", "SIGKILL", "9"} else "15"
    if pids:
        pid_list = " ".join(str(int(p)) for p in pids)
        return (
            f"echo HOST=$(hostname); "
            f"pids='{pid_list}'; "
            f"echo TARGET_PIDS=$pids; "
            f"for p in $pids; do kill -{sig} $p 2>/dev/null || true; done; "
            f"sleep 2; "
            f"for p in $pids; do kill -0 $p 2>/dev/null && kill -9 $p 2>/dev/null || true; done; "
            f"nvidia-smi --query-compute-apps=pid,process_name,used_gpu_memory --format=csv 2>/dev/null || true"
        )
    match_filter = ""
    if match:
        match_q = match.replace("'", "'\\''")
        match_filter = f"| grep -F '{match_q}' "
    return (
        "echo HOST=$(hostname); "
        "pids=$(nvidia-smi --query-compute-apps=pid,process_name --format=csv,noheader,nounits "
        "2>/dev/null "
        f"{match_filter}"
        "| awk -F',' '{gsub(/ /, \"\", $1); if ($1 ~ /^[0-9]+$/) print $1}' | sort -u); "
        "if [ -z \"$pids\" ]; then echo NO_GPU_PIDS; "
        f"else echo KILL_PIDS=$pids SIG={sig}; "
        f"for p in $pids; do kill -{sig} $p 2>/dev/null || true; done; sleep 2; "
        "for p in $pids; do kill -0 $p 2>/dev/null && kill -9 $p 2>/dev/null || true; done; fi; "
        "nvidia-smi --query-compute-apps=pid,process_name,used_gpu_memory --format=csv 2>/dev/null || true"
    )


def kill_gpu_processes(
    node: str,
    *,
    pids: list[int] | None = None,
    match: str | None = None,
    signal: str = "TERM",
    quiet: bool = False,
) -> int:
    return ansible_playbook(
        "exec.yml",
        limit=node,
        extra={
            "remote_command": build_kill_gpu_cmd(pids=pids, match=match, signal=signal),
        },
        quiet=quiet,
    )


def cmd_procs(args: argparse.Namespace) -> int:
    """列出或结束 worker 上的 GPU 计算进程。"""
    action = args.procs_action
    quiet = bool(getattr(args, "quiet", False))
    limit = resolve_limit(getattr(args, "node", None), getattr(args, "nodes", None))
    if action == "list":
        if getattr(args, "refresh", False):
            refresh_resources(quiet=quiet)
            nodes = target_worker_nodes(limit)
            print(f"{'NODE':<12} {'GPU':>3} {'PID':>8}  {'MEM':>8}  NAME")
            for name in nodes:
                occ = gpu_occupancy(name)
                procs = occ.get("processes") or []
                if not procs:
                    print(f"{name:<12} {'-':>3} {'-':>8}  {'-':>8}  (no compute apps)")
                    continue
                for proc in procs:
                    print(
                        f"{name:<12} {proc.get('gpu'):>3} {proc.get('pid'):>8}  "
                        f"{str(proc.get('memory_mib')) + 'MiB':>8}  {proc.get('name')}"
                    )
            return 0
        return ansible_playbook(
            "exec.yml",
            limit=limit,
            extra={"remote_command": LIST_GPU_PROCS_CMD},
            quiet=quiet,
        )

    if action == "kill":
        node = getattr(args, "node", None)
        if not node:
            die("procs kill 需要 --node")
        if node not in inventory_nodes():
            die(f"未知节点：{node}")
        pids = [int(x) for x in (args.pid or [])]
        if not pids and not args.all and not args.match:
            die("procs kill 需要 --pid / --all / --match")
        if args.all and (pids or args.match):
            die("--all 不能与 --pid/--match 同时使用")
        print(
            f"Killing GPU procs on {node}: "
            + (
                "all compute apps"
                if args.all
                else (f"match={args.match}" if args.match else f"pids={pids}")
            )
        )
        if args.dry_run:
            return ansible_playbook(
                "exec.yml",
                limit=node,
                extra={"remote_command": LIST_GPU_PROCS_CMD},
                quiet=quiet,
            )
        code = kill_gpu_processes(
            node,
            pids=None if args.all else (pids or None),
            match=None if args.all or pids else args.match,
            signal=args.signal or "TERM",
            quiet=quiet,
        )
        refresh_resources(quiet=quiet)
        occ = gpu_occupancy(node)
        print(
            f"after: free={occ['free']}/{occ['total']} "
            f"occupied={occ['occupied']} procs={len(occ['processes'])}"
        )
        for proc in occ["processes"][:12]:
            print(
                f"  still: gpu{proc['gpu']} pid={proc['pid']} "
                f"{proc['name']} mem={proc['memory_mib']}MiB"
            )
        return code

    die(f"未知 procs 动作：{action}")
    return 1


def cmd_free(args: argparse.Namespace) -> int:
    """腾空节点：停 Job、杀 GPU 进程（默认）、释放 lease、隔离并校验。"""
    node = args.node
    if node not in inventory_nodes():
        die(f"未知节点：{node}。已知：{', '.join(inventory_nodes())}")

    quiet = bool(args.quiet)
    jobs = [args.job] if args.job else [job["name"] for job in list_jobs()]
    stop_errors: list[str] = []
    do_kill = not bool(getattr(args, "no_kill", False))
    if getattr(args, "force", False):
        do_kill = True

    print(f"Freeing node={node}")
    print(f"  jobs: {', '.join(jobs) or '(none)'}")
    print(f"  kill_gpu_procs: {do_kill}")
    print(f"  cordon: {bool(args.cordon)}")
    if args.dry_run:
        occ = gpu_occupancy(node) if RESOURCES_FILE.is_file() else {}
        print("  dry-run: 不会执行 stop/kill/cordon")
        if occ:
            print(
                f"  snapshot: free={occ.get('free')} occupied={occ.get('occupied')} "
                f"total={occ.get('total')} procs={len(occ.get('processes') or [])}"
            )
            for proc in (occ.get("processes") or [])[:20]:
                print(
                    f"    gpu{proc['gpu']} pid={proc['pid']} "
                    f"{proc['name']} mem={proc['memory_mib']}MiB"
                )
        return 0

    for job_name in jobs:
        job = load_job(job_name)
        code = run_job_on_nodes(job, "stop", limit=node, quiet=quiet)
        if code != 0:
            stop_errors.append(f"{job_name}:rc={code}")
            print(f"warning: stop {job_name} on {node} rc={code}", file=sys.stderr)
        else:
            print(f"  stopped job={job_name}")

    if do_kill:
        print("  killing GPU compute processes")
        code = kill_gpu_processes(node, signal="TERM", quiet=quiet)
        if code != 0:
            stop_errors.append(f"kill-gpu:rc={code}")
            print(f"warning: kill GPU procs on {node} rc={code}", file=sys.stderr)

    released = release_lease_nodes([node])
    print(f"  released leases: {released}")

    if args.cordon:
        state = load_node_state()
        state.setdefault("cordoned", {})[node] = {
            "reason": args.reason or "freed for external use",
            "at": now_utc(),
            "owner": args.owner or os.environ.get("USER", "unknown"),
        }
        save_node_state(state)
        print(f"  cordoned: yes ({state['cordoned'][node]['reason']})")

    deadline = time.time() + max(0, int(args.wait or 0))
    while True:
        refresh_resources(quiet=quiet)
        occ = gpu_occupancy(node)
        print(
            f"  verify: free={occ['free']}/{occ['total']} occupied={occ['occupied']} "
            f"procs={len(occ['processes'])}"
        )
        for proc in occ["processes"][:12]:
            print(
                f"    gpu{proc['gpu']} pid={proc['pid']} "
                f"{proc['name']} mem={proc['memory_mib']}MiB"
            )
        if occ["occupied"] == 0:
            print(f"Node {node} is free" + (" and cordoned" if args.cordon else ""))
            return 0
        if time.time() >= deadline:
            break
        time.sleep(5)

    msg = (
        f"Node {node} still busy after free "
        f"(occupied={occ['occupied']}/{occ['total']})"
    )
    if stop_errors:
        msg += f"; stop_errors={stop_errors}"
    if args.allow_busy:
        print(f"warning: {msg}", file=sys.stderr)
        return 0
    print(msg, file=sys.stderr)
    print(
        "提示: gpu-control procs list --node "
        f"{node} --refresh；或 procs kill --node {node} --all；或 free --wait 30",
        file=sys.stderr,
    )
    return 1


def cmd_node(args: argparse.Namespace) -> int:
    registry = load_nodes_registry()
    nodes = registry.setdefault("nodes", {})
    defaults = registry.setdefault("defaults", {})
    state = load_node_state()
    cordoned = state.setdefault("cordoned", {})

    if args.node_action == "list":
        print(f"{'NAME':<14} {'HOST':<16} {'GPUS':>4}  {'STATE':<10} LABELS")
        for name, meta in sorted(nodes.items()):
            status = "cordoned" if name in cordoned else "schedulable"
            labels = ",".join(meta.get("labels") or []) or "-"
            gpus = resolve_node_gpu_count(name, meta, defaults=defaults)
            gpus_s = str(gpus) if gpus is not None else "?"
            print(
                f"{name:<14} {meta.get('ansible_host', '-'):<16} "
                f"{gpus_s:>4}  "
                f"{status:<10} {labels}"
            )
        return 0

    if args.node_action == "add":
        if not args.name or not args.host:
            die("node add 需要 NAME 与 --host")
        if args.name in nodes:
            die(f"节点已存在：{args.name}")
        gpus = args.gpus if args.gpus is not None else defaults.get("gpus_per_node")
        if gpus is None:
            die("node add 需要 --gpus，或在 defaults.gpus_per_node 中配置")
        node_meta = {
            "ansible_host": args.host,
            "gpus_per_node": int(gpus),
            "labels": [x.strip() for x in (args.labels or "").split(",") if x.strip()],
        }
        if getattr(args, "user", None):
            node_meta["ansible_user"] = args.user
        if getattr(args, "port", None):
            port = int(args.port)
            if not 1 <= port <= 65535:
                die("--port 必须在 1..65535")
            node_meta["ansible_port"] = port
        if getattr(args, "key", None):
            node_meta["ansible_ssh_private_key_file"] = args.key
        nodes[args.name] = node_meta
        save_nodes_registry(registry)
        print(f"Added {args.name} ({args.host}); inventory regenerated")
        return 0

    if args.node_action == "remove":
        if not args.name:
            die("node remove 需要 NAME")
        if args.name not in nodes:
            die(f"未知节点：{args.name}")
        del nodes[args.name]
        cordoned.pop(args.name, None)
        save_node_state(state)
        save_nodes_registry(registry)
        print(f"Removed {args.name}; inventory regenerated")
        return 0

    if args.node_action == "cordon":
        if not args.name:
            die("node cordon 需要 NAME")
        if args.name not in nodes:
            die(f"未知节点：{args.name}")
        cordoned[args.name] = {
            "reason": args.reason or "maintenance",
            "at": now_utc(),
            "owner": args.owner or os.environ.get("USER", "unknown"),
        }
        save_node_state(state)
        print(f"Cordoned {args.name}")
        return 0

    if args.node_action == "uncordon":
        if not args.name:
            die("node uncordon 需要 NAME")
        if args.name in cordoned:
            del cordoned[args.name]
            save_node_state(state)
            print(f"Uncordoned {args.name}")
        else:
            print(f"{args.name} was not cordoned")
        return 0

    if args.node_action == "render":
        return run_python("render_inventory.py", "--write-ssh-snippet").returncode

    die(f"未知 node 动作：{args.node_action}")
    return 1


def cmd_endpoints(args: argparse.Namespace) -> int:
    """渲染并展示推理端点目录。"""
    code = run_python("render_endpoints.py", "--write").returncode
    if code != 0:
        return code
    data = json.loads(ENDPOINTS_FILE.read_text(encoding="utf-8"))
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0
    print(f"job={data.get('job')} strategy={data.get('strategy')} count={data.get('count')}")
    print(f"api_key_file={data.get('api_key_file')}")
    print(f"{'NODE':<12} {'GPU':>3} {'URL'}")
    for ep in data.get("endpoints") or []:
        print(f"{ep['node']:<12} {ep['gpu']:>3} {ep['url']}")
    return 0


def cmd_liveness(args: argparse.Namespace) -> int:
    """节点存活与快照新鲜度：status（读缓存）/ check（立即探测）。"""
    import liveness

    action = getattr(args, "liveness_action", None) or "status"
    snapshot_path = STATE_DIR / "liveness.json"
    if action == "check":
        cmd = ["liveness_probe.py", "--json"]
        for node in getattr(args, "node", None) or []:
            cmd.extend(["--node", node])
        if getattr(args, "timeout", None):
            cmd.extend(["--timeout", str(args.timeout)])
        if not getattr(args, "json", False):
            cmd = [x for x in cmd if x != "--json"]
        return run_python(*cmd).returncode

    persisted = liveness.read_snapshot(snapshot_path)
    cluster = load_cluster()
    resources = load_resources()
    view = liveness.cluster_view(
        node_names=inventory_nodes(),
        resources=resources,
        ssh_quality=_read_json_state(STATE_DIR / "ssh_quality.json", {}),
        host_metrics=_read_json_state(STATE_DIR / "host_metrics.json", {}),
        probe=_read_json_state(PROBE_FILE, {}),
        endpoint_health=_read_json_state(STATE_DIR / "endpoint_health.json", {}),
        persisted=persisted,
        cluster=cluster,
    )
    if getattr(args, "json", False):
        print(json.dumps(view, ensure_ascii=False, indent=2))
        return 0
    summary = view.get("summary") or {}
    print(
        f"Liveness: online={summary.get('online', 0)} degraded={summary.get('degraded', 0)} "
        f"offline={summary.get('offline', 0)} unknown={summary.get('unknown', 0)} "
        f"snapshot_stale={summary.get('snapshot_stale_count', 0)} source={view.get('source')}"
    )
    for name, node in sorted((view.get("nodes") or {}).items()):
        snapshot = node.get("snapshot") or {}
        last_seen = node.get("last_seen_age_sec")
        age = liveness.format_age(last_seen) if last_seen is not None else "-"
        stale = " stale" if snapshot.get("stale") else ""
        print(
            f"{name:<14} {str(node.get('state') or 'unknown'):<9}"
            f"last_seen={age:<6} snapshot={snapshot.get('age_text') or '-':<6}{stale}"
            f"{(' — ' + str(node.get('error'))[:100]) if node.get('error') else ''}"
        )
    return 0


def cmd_remote(args: argparse.Namespace) -> int:
    """远程接入：Tailscale serve/funnel、Cloudflare quick/named tunnel。"""
    import remote_access

    action = getattr(args, "remote_action", None) or "status"
    if action == "status":
        payload = remote_access.status()
        payload["summary"] = remote_access.summary_line(payload)
        payload["recommended"] = remote_access.plan(mode="auto")
    elif action == "plan":
        payload = remote_access.plan(mode=args.mode or "auto", port=args.port)
    elif action == "up":
        payload = remote_access.up(
            mode=args.mode or "auto",
            port=args.port,
            confirm=bool(args.confirm),
            force=bool(args.force),
        )
    else:
        payload = remote_access.down(mode=args.mode or "all", confirm=bool(args.confirm))
    print(json.dumps(payload, ensure_ascii=False, indent=2))
    return 0 if payload.get("ok", True) else 1


def cmd_gateway(args: argparse.Namespace) -> int:
    """Control 统一入口：edge / LiteLLM / nginx 产物。"""
    ensure_runtime()
    action = getattr(args, "gateway_action", None) or "render"
    cmd = [action]
    if action == "litellm-db" and getattr(args, "litellm_db_action", None):
        cmd.append(args.litellm_db_action)
        if args.litellm_db_action == "url" and getattr(args, "reveal", False):
            cmd.append("--reveal")
    if action in {"render", "nginx"} and args.listen is not None:
        cmd.extend(["--listen", str(args.listen)])
    if action in {"start", "stop", "ensure"} and getattr(args, "kind", None):
        cmd.extend(["--kind", args.kind])
    return run_python("gateway_ops.py", *cmd).returncode



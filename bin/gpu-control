def cmd_logs(args: argparse.Namespace) -> int:
    """查看或清空控制面运行日志。"""
    ensure_runtime()
    sys.path.insert(0, str(PROJECT_DIR / "lib"))
    from runlog_util import clear_runlog, list_runlog

    if args.logs_action == "clear":
        print(json.dumps(clear_runlog(), ensure_ascii=False, indent=2))
        return 0
    payload = list_runlog(limit=args.limit, kind=args.kind)
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    items = payload.get("items") or []
    if not items:
        print("暂无运行日志")
        return 0
    for item in items:
        flag = "OK" if item.get("ok") else (".." if item.get("ok") is None else "FAIL")
        print(f"{item.get('ts')} [{flag}] {item.get('kind')}: {item.get('summary')}")
    print(f"({len(items)}/{payload.get('total')} · {payload.get('path')})")
    return 0



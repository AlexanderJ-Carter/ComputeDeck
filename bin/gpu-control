def cmd_toolkits(args: argparse.Namespace) -> int:
    """一站式工具栈：list / probe / install（LLaMA-Factory、DeepSpeed 等）。"""
    ensure_runtime()
    action = args.toolkits_action
    cmd = [action]
    if action in {"probe", "install"}:
        for tid in args.toolkit_ids or []:
            cmd.extend(["--id", tid])
        if args.bundle:
            cmd.extend(["--bundle", args.bundle])
        if args.node:
            cmd.extend(["--node", args.node])
        elif args.nodes:
            cmd.extend(["--nodes", args.nodes])
        if action == "install" and getattr(args, "dry_run", False):
            cmd.append("--dry-run")
        if args.quiet:
            cmd.append("--quiet")
    return run_python("toolkit_ops.py", *cmd).returncode


def cmd_models(args: argparse.Namespace) -> int:
    """模型模块：目录 / 依赖 / 校验 / 拉取 / 路径。"""
    ensure_runtime()
    action = args.models_action
    cmd = [action]
    if action == "pull":
        if not args.name and not args.model:
            die("models pull 需要 --name 或 --model")
        if args.name:
            cmd.extend(["--name", args.name])
        if args.model:
            cmd.extend(["--model", args.model])
        if args.cache:
            cmd.extend(["--cache", args.cache])
        if getattr(args, "tool", None):
            cmd.extend(["--tool", args.tool])
        if getattr(args, "register", False):
            cmd.append("--register")
        if getattr(args, "register_id", None):
            cmd.extend(["--register-id", args.register_id])
        if args.node:
            cmd.extend(["--node", args.node])
        elif args.nodes:
            cmd.extend(["--nodes", args.nodes])
        cmd.extend(["--timeout", str(args.timeout)])
    elif action in {"check", "deps", "verify", "install-tools"}:
        if getattr(args, "model", None) and action == "verify":
            cmd.extend(["--model", args.model])
        if args.node:
            cmd.extend(["--node", args.node])
        elif args.nodes:
            cmd.extend(["--nodes", args.nodes])
        if action == "install-tools":
            cmd.extend(["--timeout", str(args.timeout)])
    elif action == "paths":
        if args.node:
            cmd.extend(["--node", args.node])
    return run_python("model_ops.py", *cmd).returncode



def cmd_watchdog(args: argparse.Namespace) -> int:
    ensure_runtime()
    script = PROJECT_DIR / "scripts" / "watchdog.py"
    cmd = [
        str(VENV_PYTHON),
        str(script),
        "--interval",
        str(args.interval),
        "--max-restarts",
        str(args.max_restarts),
        "--failure-threshold",
        str(args.failure_threshold),
    ]
    jobs = args.jobs or ([default_job_name()] if default_job_name() else [])
    if not jobs:
        die("没有可监控的 Job：注册 Job 或传入 --job")
    for job in jobs:
        cmd.extend(["--job", job])
    if args.nodes:
        cmd.extend(["--nodes", args.nodes])
    if args.once:
        cmd.append("--once")
    if args.background:
        log_path = STATE_DIR / "watchdog.log"
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        pid_file = STATE_DIR / "watchdog.pid"
        if pid_file.is_file():
            old = pid_file.read_text(encoding="utf-8").strip()
            if old.isdigit() and pid_alive(int(old)) and _pid_looks_like_watchdog(int(old)):
                print(f"Watchdog already running pid={old} log={log_path}")
                return 0
            pid_file.unlink(missing_ok=True)
        with log_path.open("a", encoding="utf-8") as log_fh:
            proc = subprocess.Popen(
                cmd,
                cwd=PROJECT_DIR,
                stdout=log_fh,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        print(f"Watchdog started pid={proc.pid} log={log_path}")
        return 0
    print("+", " ".join(cmd))
    return subprocess.call(cmd, cwd=PROJECT_DIR)


def cmd_queue(args: argparse.Namespace) -> int:
    if args.queue_action == "list":
        workloads = load_queue().get("workloads") or []
        if not workloads:
            print("Queue empty")
            return 0
        print(f"{'ID':<22} {'STATUS':<10} {'JOB':<12} {'GPUS':>4}  NODES  NOTE")
        for wl in workloads:
            nodes = ",".join(wl.get("selected_nodes") or []) or (wl.get("nodes") or "-")
            print(
                f"{wl['id']:<22} {wl['status']:<10} {wl['job']:<12} "
                f"{wl.get('gpus', 0):>4}  {nodes}  {wl.get('note') or '-'}"
            )
        return 0

    if args.queue_action == "submit":
        if not args.job:
            die("queue submit 需要 Job 名")
        load_job(args.job)
        wl = {
            "id": f"wl-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}",
            "job": args.job,
            "gpus": resolve_unit_gpus(args.gpus),
            "nodes": args.nodes,
            "status": "pending",
            "selected_nodes": [],
            "owner": args.owner or os.environ.get("USER", "unknown"),
            "note": args.note or "",
            "message": "",
            "created_at": now_utc(),
            "updated_at": now_utc(),
        }

        def append_wl(data: dict) -> None:
            data.setdefault("workloads", []).append(wl)

        mutate_queue(append_wl)
        print(json.dumps(wl, ensure_ascii=False, indent=2))
        if args.schedule:
            args.queue_action = "schedule"
            return cmd_queue(args)
        return 0

    if args.queue_action == "cancel":
        if not args.workload_id:
            die("queue cancel 需要 --id")
        cancelled = {"ok": False}

        def cancel_wl(data: dict) -> None:
            for item in data.setdefault("workloads", []):
                if item.get("id") == args.workload_id and item.get("status") in {
                    "pending",
                    "admitted",
                }:
                    item["status"] = "cancelled"
                    item["updated_at"] = now_utc()
                    item["message"] = "cancelled by user"
                    cancelled["ok"] = True
                    return

        mutate_queue(cancel_wl)
        if not cancelled["ok"]:
            die(f"无可取消的工作负载：{args.workload_id}")
        print(f"Cancelled {args.workload_id}")
        return 0

    if args.queue_action == "schedule":
        pending_ids = [
            wl["id"]
            for wl in (load_queue().get("workloads") or [])
            if wl.get("status") == "pending"
        ]
        if not pending_ids:
            print("No pending workloads")
            return 0
        quiet = bool(args.quiet)
        code = refresh_resources(quiet=quiet)
        if code != 0:
            return code

        admitted = 0
        for wl_id in pending_ids:
            current = next(
                (
                    item
                    for item in (load_queue().get("workloads") or [])
                    if item.get("id") == wl_id
                ),
                None,
            )
            if not current or current.get("status") != "pending":
                continue
            print(
                f"\n--- scheduling {wl_id} job={current['job']} gpus={current['gpus']} ---"
            )
            patch_queue_workload(wl_id, status="admitted", updated_at=now_utc())

            selected = None
            if current.get("nodes"):
                if current["nodes"] == "all":
                    selected = inventory_nodes()
                else:
                    selected = [
                        n.strip() for n in current["nodes"].split(",") if n.strip()
                    ]
            else:
                result = run_python_capture(
                    "select_nodes.py", *select_nodes_cli_args(current["gpus"])
                )
                print(result.stdout, end="")
                if result.returncode != 0:
                    patch_queue_workload(
                        wl_id,
                        status="pending",
                        message="insufficient free GPUs; kept pending",
                        updated_at=now_utc(),
                    )
                    print(f"{wl_id}: still pending (no capacity)")
                    continue
                selected = json.loads(result.stdout.strip().splitlines()[-1])["selected"]

            patch_queue_workload(
                wl_id,
                status="running",
                selected_nodes=selected,
                updated_at=now_utc(),
            )

            rc, selected_nodes = deploy_job(
                current["job"],
                gpus=current["gpus"],
                nodes=None,
                selected=selected,
                restart=False,
                no_wait=False,
                note=current.get("note") or f"queue:{wl_id}",
                quiet=quiet,
            )
            if rc == 0:
                patch_queue_workload(
                    wl_id,
                    status="ready",
                    selected_nodes=selected_nodes,
                    message="deployed",
                    updated_at=now_utc(),
                )
                admitted += 1
            else:
                patch_queue_workload(
                    wl_id,
                    status="failed",
                    message=f"deploy failed rc={rc}",
                    updated_at=now_utc(),
                )
            # Refresh after each admission so next pending sees new leases/usage
            refresh_resources(quiet=quiet)

        pending_left = sum(
            1
            for wl in (load_queue().get("workloads") or [])
            if wl.get("status") == "pending"
        )
        print(f"\nSchedule finished: admitted/ready={admitted}, pending_left={pending_left}")
        return 0

    die(f"未知 queue 动作：{args.queue_action}")
    return 1


def cmd_lease(args: argparse.Namespace) -> int:
    if args.lease_action == "list":
        leases = load_leases().get("leases") or []
        if not leases:
            print("No active leases")
            return 0
        for lease in leases:
            print(
                f"{lease['id']}: job={lease['job']} nodes={','.join(lease['nodes'])} "
                f"gpus={lease['gpus']} owner={lease.get('owner', '-')} "
                f"since={lease.get('created_at', '-')}"
            )
        return 0

    if args.lease_action == "acquire":
        if not args.job or not args.nodes:
            die("lease acquire 需要 --job 与 --nodes")
        node_list = [n.strip() for n in args.nodes.split(",") if n.strip()]
        if args.gpus is not None:
            lease_gpus = int(args.gpus)
        else:
            registry = load_nodes_registry()
            defaults = registry.get("defaults") or {}
            nodes_meta = registry.get("nodes") or {}
            total = 0
            for n in node_list:
                count = resolve_node_gpu_count(n, nodes_meta.get(n) or {}, defaults=defaults)
                if count is None:
                    die(f"lease acquire：节点 {n} 未配置 gpus_per_node，请传 --gpus")
                total += count
            lease_gpus = total
        lease = acquire_lease(
            args.job,
            node_list,
            gpus=lease_gpus,
            note=args.note or "",
            owner=args.owner,
        )
        print(json.dumps(lease, ensure_ascii=False, indent=2))
        return 0

    if args.lease_action == "release":
        if not args.lease_id and not args.nodes:
            die("lease release 需要 --id 或 --nodes")
        if args.lease_id:
            released = release_lease_id(args.lease_id)
            print(f"Released {released} lease(s)")
        else:
            released = release_lease_nodes(
                [n.strip() for n in args.nodes.split(",") if n.strip()]
            )
            print(f"Released {released} lease(s)")
        return 0

    die(f"未知 lease 动作：{args.lease_action}")
    return 1


def cmd_get(args: argparse.Namespace) -> int:
    """类 kubectl 的资源列表。"""
    kind = args.resource
    if kind in {"nodes", "node"}:
        args.node_action = "list"
        return cmd_node(args)
    if kind in {"jobs", "job"}:
        return cmd_jobs(args)
    if kind in {"leases", "lease"}:
        args.lease_action = "list"
        return cmd_lease(args)
    if kind in {"queue", "workloads"}:
        args.queue_action = "list"
        return cmd_queue(args)
    if kind in {"endpoints", "endpoint"}:
        return cmd_endpoints(args)
    if kind in {"cluster", "overview"}:
        args.cached = True
        args.job = None
        return cmd_overview(args)
    die(f"未知资源：{kind}。可选：nodes|jobs|leases|queue|endpoints|cluster")
    return 1


def cmd_describe(args: argparse.Namespace) -> int:
    """类 kubectl 的资源详情。"""
    kind = args.resource
    name = args.name
    if kind in {"node", "nodes"}:
        if not name:
            die("describe node 需要 NAME")
        registry = load_nodes_registry().get("nodes", {})
        if name not in registry:
            die(f"未知节点：{name}")
        resources = json.loads(RESOURCES_FILE.read_text(encoding="utf-8")) if RESOURCES_FILE.is_file() else {}
        leases = load_leases().get("leases", [])
        cordoned = load_node_state().get("cordoned", {})
        node = resources.get(name, {})
        meta = registry[name]
        lease = next((l for l in leases if name in l.get("nodes", [])), None)
        print(f"Name:        {name}")
        print(f"Host:        {meta.get('ansible_host')}")
        gpus = resolve_node_gpu_count(name, meta, defaults=load_nodes_registry().get("defaults") or {}, live=node)
        print(f"GPUs:        {gpus if gpus is not None else '?'}")
        print(f"Labels:      {','.join(meta.get('labels') or []) or '-'}")
        print(f"Role:        {meta.get('role') or '-'}")
        print(f"Note:        {meta.get('note') or '-'}")
        print(f"State:       {'cordoned' if name in cordoned else 'schedulable'}")
        if name in cordoned:
            print(f"Cordon:      {cordoned[name]}")
        print(f"Lease:       {lease['id'] + ' / ' + lease['job'] if lease else '-'}")
        print(f"Free/Used:   {node.get('free_count', '?')}/{node.get('occupied_count', '?')}")
        print("GPUs detail:")
        for gpu in node.get("gpus") or []:
            print(
                f"  - index={gpu.get('index')} status={gpu.get('status')} "
                f"mem={gpu.get('memory_used_mib')}/{gpu.get('memory_total_mib')} "
                f"util={gpu.get('utilization_percent')}%"
            )
        return 0
    if kind in {"job", "jobs"}:
        if not name:
            die("describe job 需要 NAME")
        job = load_job(name)
        print(json.dumps(job, ensure_ascii=False, indent=2))
        return 0
    die(f"未知资源：{kind}。可选：node|job")
    return 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gpu-control",
        description=(
            "GPU 集群控制面（CLI + Web）。\n"
            "理念借鉴：kubectl 资源动词 / Ray 可观测分层 / Slurm cordon&队列。"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "常用（CLI）:\n"
            "  gpu-control get nodes\n"
            "  gpu-control describe node gpu-1\n"
            "  gpu-control get endpoints\n"
            "  gpu-control health\n"
            "  gpu-control deploy <job> --gpus 4\n"
            "  gpu-control free --node gpu-2 --cordon\n"
            "  gpu-control ui --background\n"
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_get = sub.add_parser("get", help="列出资源（kubectl 风格）：nodes|jobs|leases|queue|endpoints|cluster")
    p_get.add_argument(
        "resource",
        help="nodes|jobs|leases|queue|endpoints|cluster",
    )
    p_get.set_defaults(func=cmd_get)

    p_describe = sub.add_parser("describe", help="查看资源详情（kubectl 风格）：node|job")
    p_describe.add_argument("resource", help="node|job")
    p_describe.add_argument("name", nargs="?", help="资源名")
    p_describe.set_defaults(func=cmd_describe)

    p_overview = sub.add_parser("overview", aliases=["cluster"], help="集群总览（GPU + lease）")
    p_overview.add_argument("--cached", action="store_true", help="不刷新，使用已有 resources.json")
    p_overview.add_argument("--job", help="同时查询某任务就绪状态")
    p_overview.set_defaults(func=cmd_overview)

    p_status = sub.add_parser("status", help="查看任务状态（默认 cluster.default_job）")
    p_status.add_argument("job", nargs="?", default=None)
    p_status.add_argument("--node")
    p_status.add_argument("--nodes")
    p_status.add_argument(
        "--arg",
        dest="extra_args",
        action="append",
        default=None,
        help="覆盖 job.extra_args，可重复",
    )
    p_status.add_argument("--quiet", action="store_true")
    p_status.set_defaults(func=cmd_status_default)

    for name, help_text in (
        ("start", "在选定节点启动任务"),
        ("stop", "在选定节点停止任务"),
        ("restart", "在选定节点重启任务"),
        ("wait", "等待任务就绪"),
    ):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("job")
        p.add_argument("--node")
        p.add_argument("--nodes", help="逗号分隔，或 all")
        p.add_argument(
            "--arg",
            dest="extra_args",
            action="append",
            default=None,
            help="覆盖 job.extra_args，可重复，如 --arg --base-port --arg 8000",
        )
        p.add_argument(
            "--allow-cordoned",
            action="store_true",
            help="允许在已隔离节点上 start/restart",
        )
        p.add_argument("--quiet", action="store_true")
        p.set_defaults(func=cmd_job_action, action=name)

    p_deploy = sub.add_parser("deploy", help="选节点 → 启动 → 等待 → 登记占用（一键）")
    p_deploy.add_argument("job")
    p_deploy.add_argument(
        "--gpus",
        type=int,
        default=None,
        help="所需 GPU 总数；省略则用 cluster.scheduling.unit_gpus（指定 --nodes 时可省略）",
    )
    p_deploy.add_argument("--nodes", help="指定节点；不填则自动挑选空闲节点")
    p_deploy.add_argument("--restart", action="store_true", help="部署前先 stop")
    p_deploy.add_argument("--no-wait", action="store_true")
    p_deploy.add_argument("--note", default="")
    p_deploy.add_argument(
        "--allow-cordoned",
        action="store_true",
        help="允许部署到已隔离节点（默认拒绝）",
    )
    p_deploy.add_argument(
        "--force",
        action="store_true",
        help="覆盖异主租约（先 release 再部署）",
    )
    p_deploy.add_argument("--quiet", action="store_true")
    p_deploy.set_defaults(func=cmd_deploy)

    p_jobs = sub.add_parser("jobs", help="列出 / 安装任务（Job 插件）")
    p_jobs.add_argument(
        "jobs_action",
        nargs="?",
        default="list",
        choices=["list", "templates", "install", "logs"],
    )
    p_jobs.add_argument("template", nargs="?", help="install 的模板 id / logs 的 Job 名")
    p_jobs.add_argument("--name", help="install 时写入的 Job 名（默认用模板名）")
    p_jobs.add_argument(
        "--recommended",
        action="store_true",
        help="install 时一键安装推荐模板包（推理/训练/Ray/Docker）",
    )
    p_jobs.add_argument(
        "--force",
        action="store_true",
        help="与 --recommended 同用：覆盖已安装同名 Job",
    )
    p_jobs.add_argument("--lines", type=int, default=120, help="logs 尾部行数")
    p_jobs.add_argument("--node", help="logs 只看一个节点")
    p_jobs.add_argument("--nodes", help="logs 节点列表（逗号分隔）")
    p_jobs.add_argument("--json", action="store_true")
    p_jobs.set_defaults(func=cmd_jobs)

    p_gpu = sub.add_parser("gpu", help="查看 / 刷新 GPU 资源")
    p_gpu.add_argument("action", nargs="?", default="list", choices=["list", "refresh"])
    p_gpu.add_argument("--node")
    p_gpu.add_argument("--nodes")
    p_gpu.add_argument("--refresh", action="store_true")
    p_gpu.add_argument("--quiet", action="store_true")
    p_gpu.set_defaults(func=cmd_gpu)

    p_plan = sub.add_parser("plan", help="刷新资源并挑选空闲节点")
    p_plan.add_argument(
        "--gpus",
        type=int,
        default=None,
        help="所需 GPU 总数；省略则用 cluster.scheduling.unit_gpus",
    )
    p_plan.add_argument("--quiet", action="store_true")
    p_plan.set_defaults(func=cmd_plan)

    p_exec = sub.add_parser("exec", help="在多个节点并行执行同一命令")
    p_exec.add_argument("command", nargs=argparse.REMAINDER, help="远端命令，建议加 -- 分隔")
    p_exec.add_argument("--node")
    p_exec.add_argument("--nodes", default="all")
    p_exec.add_argument("--quiet", action="store_true")
    p_exec.set_defaults(func=cmd_exec)

    p_lease = sub.add_parser("lease", help="节点占用登记（防抢占）")
    p_lease.add_argument("lease_action", choices=["list", "acquire", "release"])
    p_lease.add_argument("--id", dest="lease_id")
    p_lease.add_argument("--job")
    p_lease.add_argument("--nodes")
    p_lease.add_argument("--gpus", type=int)
    p_lease.add_argument("--owner")
    p_lease.add_argument("--note")
    p_lease.set_defaults(func=cmd_lease)

    p_ui = sub.add_parser("ui", help="启动 Web 管理台（默认 :8787）")
    p_ui.add_argument("--host", default=None, help="默认读 cluster.control.ui_host，否则 127.0.0.1")
    p_ui.add_argument("--port", type=int, default=None, help="默认读 cluster.control.ui_port，否则 8787")
    p_ui.add_argument("--background", action="store_true", help="后台守护并写 state/ui.pid")
    p_ui.set_defaults(func=cmd_ui)

    p_queue = sub.add_parser("queue", help="简易工作负载队列（pending→ready）")
    p_queue.add_argument("queue_action", choices=["list", "submit", "cancel", "schedule"])
    p_queue.add_argument("job", nargs="?", help="submit 时的任务名")
    p_queue.add_argument(
        "--gpus",
        type=int,
        default=None,
        help="所需 GPU 总数；省略则用 cluster.scheduling.unit_gpus",
    )
    p_queue.add_argument("--nodes", help="指定节点；不填则调度时自动挑选")
    p_queue.add_argument("--id", dest="workload_id", help="cancel 用")
    p_queue.add_argument("--note", default="")
    p_queue.add_argument("--owner")
    p_queue.add_argument("--schedule", action="store_true", help="submit 后立刻尝试调度")
    p_queue.add_argument("--quiet", action="store_true")
    p_queue.set_defaults(func=cmd_queue)

    p_probe = sub.add_parser("probe", help="探测节点间 TCP 互通（分布式前置检查）")
    p_probe.add_argument("--port", type=int, default=22, help="探测端口（默认 22；可按集群 SSH 端口改）")
    p_probe.add_argument("--timeout", type=float, default=3.0)
    p_probe.add_argument("--quiet", action="store_true")
    p_probe.set_defaults(func=cmd_probe)

    p_endpoints = sub.add_parser("endpoints", help="列出 API 端点目录（render_endpoints）")
    p_endpoints.add_argument("--json", action="store_true")
    p_endpoints.set_defaults(func=cmd_endpoints)

    p_remote = sub.add_parser("remote", help="远程接入：Tailscale / Cloudflare（status|plan|up|down）")
    p_remote.add_argument("remote_action", nargs="?", default="status", choices=["status", "plan", "up", "down"])
    p_remote.add_argument(
        "--mode",
        default="auto",
        choices=["auto", "tailscale-serve", "tailscale-funnel", "cloudflared-quick", "cloudflared-tunnel", "all"],
    )
    p_remote.add_argument("--port", type=int, default=None, help="控制面端口（默认 cluster.control.ui_port）")
    p_remote.add_argument("--confirm", action="store_true", help="确认启动/关闭")
    p_remote.add_argument("--force", action="store_true", help="即使鉴权未开启也允许公网暴露")
    p_remote.set_defaults(func=cmd_remote)

    p_liveness = sub.add_parser("liveness", help="节点存活 / 快照新鲜度（status 读缓存，check 立即探测）")
    p_liveness.add_argument("liveness_action", nargs="?", default="status", choices=["status", "check"])
    p_liveness.add_argument("--node", action="append", default=[], help="只检查指定节点，可重复")
    p_liveness.add_argument("--timeout", type=float, default=None, help="单节点 TCP 超时秒数")
    p_liveness.add_argument("--json", action="store_true")
    p_liveness.set_defaults(func=cmd_liveness)

    p_gateway = sub.add_parser(
        "gateway",
        help="Control 统一入口：edge 反代 / LiteLLM / nginx 产物",
    )
    p_gateway.add_argument(
        "gateway_action",
        nargs="?",
        default="render",
        choices=["render", "status", "ensure", "start", "stop", "nginx", "install-litellm", "litellm-db"],
        help="默认 render；ensure=规整配套并拉起主入口；litellm-db=LiteLLM 管理数据库",
    )
    p_gateway.add_argument(
        "litellm_db_action",
        nargs="?",
        default=None,
        choices=["status", "init", "start", "stop", "url", "apply-schema"],
        help="gateway litellm-db 的子动作（默认 status）",
    )
    p_gateway.add_argument("--listen", type=int, default=None, help="edge/nginx listen 端口")
    p_gateway.add_argument(
        "--kind",
        choices=["edge", "litellm", "both", "nginx", "all"],
        help="start/stop/ensure 目标（默认读 cluster.gateway.ingress.kind）",
    )
    p_gateway.add_argument("--json", action="store_true", help="兼容旧参数（忽略）")
    p_gateway.add_argument(
        "--reveal",
        action="store_true",
        help="gateway litellm-db url 时输出完整连接串（默认只显示脱敏地址）",
    )
    p_gateway.set_defaults(func=cmd_gateway)

    p_health = sub.add_parser("health", help="探测全部推理 API 健康（默认各节点本地探测）")
    p_health.add_argument("--mode", choices=["local", "direct"], default="local")
    p_health.add_argument("--timeout", type=float, default=2.0)
    p_health.add_argument("--workers", type=int, default=16)
    p_health.add_argument("--json", action="store_true")
    p_health.set_defaults(func=cmd_health)

    p_doctor = sub.add_parser("doctor", help="配置与运行环境自检（发布前）")
    p_doctor.add_argument("--json", action="store_true")
    p_doctor.set_defaults(func=cmd_doctor)

    p_docs = sub.add_parser("docs", help="MkDocs 文档站（类 Read the Docs）")
    p_docs.add_argument("docs_action", choices=["build", "serve", "clean"])
    p_docs.add_argument("--host", default="127.0.0.1")
    p_docs.add_argument("--port", type=int, default=8000)
    p_docs.set_defaults(func=cmd_docs)

    p_diag = sub.add_parser("diagnose", help="一键检测 / 安全自动修复")
    p_diag.add_argument("diagnose_action", choices=["check", "repair"])
    p_diag.add_argument("--id", action="append", default=[], dest="fix_ids", help="repair 时指定 finding id")
    p_diag.set_defaults(func=cmd_diagnose)

    p_logs = sub.add_parser("logs", help="控制面运行日志")
    p_logs.add_argument("logs_action", nargs="?", default="show", choices=["show", "clear"])
    p_logs.add_argument("--limit", type=int, default=40)
    p_logs.add_argument("--kind", help="过滤 kind，如 oneclick|cli|diagnose|repair")
    p_logs.add_argument("--json", action="store_true")
    p_logs.set_defaults(func=cmd_logs)

    p_auth = sub.add_parser("auth", help="控制面 UI 鉴权（密码 / Token / OIDC）")
    p_auth.add_argument(
        "auth_action",
        choices=["status", "set-password", "set-mode", "issue-token", "oidc-check"],
    )
    p_auth.add_argument("mode", nargs="?", choices=["none", "password", "oidc"], help="set-mode 目标")
    p_auth.add_argument("--password", help="set-password 明文（省略则交互输入）")
    p_auth.add_argument("--generate", action="store_true", help="set-password 随机生成")
    p_auth.add_argument("--enable", action="store_true", help="写入后启用 mode=password")
    p_auth.set_defaults(func=cmd_auth)

    p_procs = sub.add_parser("procs", help="列出 / 结束节点上的 GPU 占用进程")
    p_procs.add_argument("procs_action", choices=["list", "kill"], help="list|kill")
    p_procs.add_argument("--node", help="节点名（kill 必填；list 可配合 --nodes）")
    p_procs.add_argument("--nodes", help="list 时多节点，逗号分隔或 all")
    p_procs.add_argument("--pid", action="append", type=int, help="kill 指定 PID，可重复")
    p_procs.add_argument("--all", action="store_true", help="kill 该节点全部 GPU compute 进程")
    p_procs.add_argument("--match", help="按进程名子串筛选后 kill，如 python")
    p_procs.add_argument(
        "--signal",
        default="TERM",
        help="先发信号（TERM/KILL），默认 TERM，仍存活再 KILL",
    )
    p_procs.add_argument(
        "--refresh",
        action="store_true",
        help="list 时先刷新快照并用结构化表输出",
    )
    p_procs.add_argument("--dry-run", action="store_true", help="kill 前只列出进程")
    p_procs.add_argument("--quiet", action="store_true")
    p_procs.set_defaults(func=cmd_procs)

    p_free = sub.add_parser(
        "free",
        help="腾空节点：停 Job → 杀 GPU 进程（默认）→ 释 lease →（可选）cordon → 校验",
    )
    p_free.add_argument("--node", required=True, help="要腾空的节点")
    p_free.add_argument("--job", help="只停指定任务；默认停掉所有已注册任务")
    p_free.add_argument("--cordon", action="store_true", help="腾空后禁止调度器再选中该节点")
    p_free.add_argument(
        "--force",
        action="store_true",
        help="兼容旧参数：等同默认杀进程行为",
    )
    p_free.add_argument(
        "--no-kill",
        action="store_true",
        help="只停注册 Job，不杀 nvidia-smi compute 进程",
    )
    p_free.add_argument(
        "--wait",
        type=int,
        default=0,
        help="校验前等待秒数（循环刷新，直到空闲或超时）",
    )
    p_free.add_argument(
        "--allow-busy",
        action="store_true",
        help="校验仍占用时不返回失败（默认占用则 rc=1）",
    )
    p_free.add_argument("--dry-run", action="store_true", help="只打印计划，不执行")
    p_free.add_argument("--reason", default="")
    p_free.add_argument("--owner")
    p_free.add_argument("--quiet", action="store_true")
    p_free.set_defaults(func=cmd_free)

    p_node = sub.add_parser("node", help="节点清单管理（扩展集群 / cordon）")
    p_node.add_argument(
        "node_action",
        choices=["list", "add", "remove", "cordon", "uncordon", "render"],
    )
    p_node.add_argument("name", nargs="?", help="节点名")
    p_node.add_argument("--host", help="ansible_host / IP")
    p_node.add_argument("--gpus", type=int, help="该节点 GPU 数")
    p_node.add_argument("--labels", help="逗号分隔标签")
    p_node.add_argument("--user", help="该节点的 SSH 用户（覆盖 defaults.ansible_user）")
    p_node.add_argument("--port", type=int, help="该节点的 SSH 端口（覆盖 defaults.ansible_port）")
    p_node.add_argument("--key", help="该节点的 SSH 私钥路径（覆盖 defaults.ansible_ssh_private_key_file）")
    p_node.add_argument("--reason", default="")
    p_node.add_argument("--owner")
    p_node.set_defaults(func=cmd_node)

    p_watch = sub.add_parser("watchdog", help="任务挂了自动重启")
    p_watch.add_argument("--job", action="append", dest="jobs", help="可重复指定多个任务")
    p_watch.add_argument("--nodes", help="只监控这些节点")
    p_watch.add_argument("--interval", type=int, default=60)
    p_watch.add_argument("--max-restarts", type=int, default=3)
    p_watch.add_argument("--failure-threshold", type=int, default=2, help="连续失败几次才重启")
    p_watch.add_argument("--once", action="store_true", help="只检查一轮")
    p_watch.add_argument("--background", action="store_true", help="后台守护")
    p_watch.set_defaults(func=cmd_watchdog)

    p_metrics = sub.add_parser("metrics", help="采集各节点 CPU / 内存 / 负载")
    p_metrics.set_defaults(func=cmd_metrics)

    p_toolkits = sub.add_parser(
        "toolkits",
        help="一站式 AI 工具栈：LLaMA-Factory / DeepSpeed / vLLM 等",
    )
    p_toolkits.add_argument(
        "toolkits_action",
        choices=["list", "probe", "install"],
        help="list|probe|install",
    )
    p_toolkits.add_argument("--id", action="append", default=[], dest="toolkit_ids")
    p_toolkits.add_argument("--bundle", help="如 train-stack / serve-stack")
    p_toolkits.add_argument("--node")
    p_toolkits.add_argument("--nodes", default="all")
    p_toolkits.add_argument("--dry-run", action="store_true")
    p_toolkits.add_argument("--quiet", action="store_true")
    p_toolkits.set_defaults(func=cmd_toolkits)

    p_models = sub.add_parser(
        "models",
        help="可选模块：目录/依赖/校验/拉取（见 docs/手册.md）",
    )
    p_models.add_argument(
        "models_action",
        choices=["show", "list", "check", "verify", "deps", "install-tools", "pull", "paths"],
        help="show|list|check|verify|deps|install-tools|pull|paths",
    )
    p_models.add_argument("--name", help="pull 时的仓库 id")
    p_models.add_argument("--model", help="models[].id")
    p_models.add_argument("--cache", help="caches[].id")
    p_models.add_argument(
        "--tool",
        choices=["auto", "huggingface-cli", "modelscope"],
        help="pull 工具（默认看 models.json pull.tool）",
    )
    p_models.add_argument("--register", action="store_true", help="pull 成功后写入 models.json")
    p_models.add_argument("--register-id", help="登记本地 id")
    p_models.add_argument("--node")
    p_models.add_argument("--nodes", default="all")
    p_models.add_argument("--timeout", type=int, default=3600)
    p_models.set_defaults(func=cmd_models)

    return parser


def main() -> int:
    os.chdir(PROJECT_DIR)
    parser = build_parser()
    args = parser.parse_args()
    # argparse.REMAINDER keeps a leading '--' sometimes
    if getattr(args, "command", None) and isinstance(args.command, list):
        if args.command and args.command[0] == "--":
            args.command = args.command[1:]
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())

# Python / venv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Local machine configs & secrets (do not publish)
config/local/**
!config/local/.gitkeep
deploy/ssh/**
!deploy/ssh/.gitkeep
!deploy/ssh/README.md

# Root compat symlinks → config/local (machine-specific)
/cluster.json
/nodes.json

# Generated / runtime state
state/**
!state/.gitkeep
snapshots/**
!snapshots/.gitkeep
# MkDocs 构建产物（gpu-control docs build）
web/static/help/
inventory.ini
resources.json
*.pid
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Temporary
*.tmp

# Agent scratch (do not commit)
docs/superpowers/

# Local MCP client config (may contain token); keep *.example
.mcp.json
.cursor/mcp.json

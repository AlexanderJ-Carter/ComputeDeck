{
  "defaults": {
    "ansible_user": "ubuntu",
    "ansible_port": 22,
    "ansible_connection": "ssh",
    "ansible_ssh_private_key_file": "${HOME}/.ssh/id_ed25519",
    "gpus_per_node": 4,
    "role": "serving"
  },
  "control": {
    "name": "control",
    "ansible_host": "10.0.0.10",
    "ui_host": "0.0.0.0",
    "ui_port": 8787,
    "note": "主控机：只在此跑 UI / CLI / Ansible"
  },
  "nodes": {
    "control": {
      "ansible_host": "10.0.0.10",
      "gpus_per_node": 4,
      "labels": ["control", "a100"],
      "role": "control",
      "note": "主控；调度默认 avoid=control"
    },
    "gpu-1": {
      "ansible_host": "10.0.0.1",
      "gpus_per_node": 4,
      "labels": ["a100", "serving"],
      "role": "serving",
      "note": "GPU 工作节点"
    },
    "gpu-2": {
      "ansible_host": "10.0.0.2",
      "gpus_per_node": 4,
      "labels": ["a100", "serving"],
      "role": "serving"
    }
  }
}

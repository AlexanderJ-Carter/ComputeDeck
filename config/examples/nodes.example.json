{
  "defaults": {
    "ansible_user": "ubuntu",
    "ansible_port": 22,
    "ansible_connection": "ssh",
    "ansible_ssh_private_key_file": "${HOME}/.ssh/id_ed25519",
    "gpus_per_node": 4,
    "role": "serving",
    "paths": {
      "python": "/usr/bin/python3",
      "repo": "/path/to/gpu-control",
      "model_root": "/data/models",
      "workdir": "/tmp/gpu-workdir",
      "cache": "/data/hf-cache"
    }
  },
  "control": {
    "name": "control",
    "ansible_host": "10.0.0.10",
    "ui_host": "0.0.0.0",
    "ui_port": 8787,
    "note": "CPU Control：只在此跑 UI / CLI / Ansible，不进 gpu_workers"
  },
  "nodes": {
    "gpu-1": {
      "ansible_host": "10.0.0.1",
      "gpus_per_node": 4,
      "labels": ["a100", "serving"],
      "role": "serving",
      "note": "端口默认跟 gpus_per_node；也可写 ports_per_node / base_port"
    },
    "gpu-2": {
      "ansible_host": "10.0.0.2",
      "gpus_per_node": 8,
      "ports_per_node": 8,
      "base_port": 9000,
      "labels": ["a100", "serving"],
      "role": "serving",
      "paths": {
        "python": "/opt/alt/bin/python",
        "model_root": "/mnt/shared/models",
        "cache": "/mnt/shared/hf-cache"
      },
      "note": "8 卡异构示例：自定义 base_port=9000 → 9000–9007"
    }
  }
}

{
  "description": "可选：复制到 config/local/toolkits.json 覆盖/扩展内置工具栈",
  "toolkits": [
    {
      "id": "llamafactory",
      "install_pip": [
        "llamafactory[torch,metrics]"
      ]
    },
    {
      "id": "ray",
      "install_pip": [
        "ray[default]"
      ]
    },
    {
      "id": "vllm",
      "install_pip": [
        "vllm"
      ]
    }
  ],
  "bundles": [
    {
      "id": "train-stack",
      "name": "微调栈",
      "description": "LLaMA-Factory + DeepSpeed + Accelerate + PEFT",
      "toolkits": [
        "accelerate",
        "deepspeed",
        "peft",
        "llamafactory"
      ]
    },
    {
      "id": "ray-stack",
      "name": "Ray 分布式栈",
      "description": "Ray + torch + transformers",
      "toolkits": [
        "ray",
        "torch",
        "transformers"
      ]
    }
  ]
}

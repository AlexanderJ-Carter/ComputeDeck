{
  "name": "my-gpu-pool",
  "strategy": "inference-pool",
  "description": "Copy to ../local/cluster.json. default_job = 你注册的任一 Job 名。",
  "default_job": "shell-job",
  "control": {
    "node": "control",
    "host": "10.0.0.10",
    "ui_host": "0.0.0.0",
    "ui_port": 8787,
    "note": "CPU control host only — UI/CLI/Ansible; not a GPU worker",
    "auth": {
      "mode": "password",
      "session_ttl_hours": 168,
      "password_hash_file": "config/local/secrets/ui_password.hash",
      "session_secret_file": "config/local/secrets/ui_session_secret",
      "api_token_file": "config/local/secrets/ui_api_token",
      "oidc": {
        "issuer": "https://login.example.com",
        "client_id": "gpu-control",
        "client_secret_file": "config/local/secrets/oidc_client_secret",
        "redirect_path": "/api/auth/oidc/callback",
        "scopes": [
          "openid",
          "profile",
          "email"
        ],
        "username_claim": "email",
        "allowed_emails": [],
        "allowed_subjects": [],
        "allowed_groups": [],
        "allow_password_fallback": false,
        "require_userinfo": true
      }
    },
    "assistant": {
      "enabled": true,
      "base_url": "",
      "model": "",
      "api_key_env": "GPU_CONTROL_ASSISTANT_API_KEY",
      "api_key_file": "config/local/secrets/assistant_api_key",
      "timeout_sec": 60,
      "note": "OpenAI 兼容 Chat Completions；留空则 UI 小助手降级为讲解 + 快捷动作"
    }
  },
  "api": {
    "base_port": 8000,
    "ports_per_node": 1,
    "health_path": "/health",
    "sample_path": "/health",
    "paths": [
      "/health"
    ],
    "auth_header": "Authorization",
    "auth_env": "INFERENCE_API_KEY",
    "api_key_file": "${GPU_CONTROL_API_KEY_FILE}"
  },
  "gateway": {
    "ingress": {
      "enabled": true,
      "bind": "0.0.0.0",
      "port": 18080,
      "kind": "edge",
      "domain": "",
      "domains": [],
      "public_base_url": "http://10.0.0.10:18080",
      "strategy": "round_robin",
      "retries": 2,
      "cooldown_sec": 30,
      "connect_timeout_sec": 2,
      "read_timeout_sec": 300,
      "sticky_header": "",
      "tls": {
        "enabled": false,
        "cert_file": "config/local/secrets/ingress.crt",
        "key_file": "config/local/secrets/ingress.key",
        "ca_file": "",
        "require_client_cert": false,
        "min_version": "TLSv1.2"
      }
    },
    "model_name": "gpu-pool",
    "litellm_model": "openai/local-model",
    "openai_api_base_path": "/v1",
    "routing_strategy": "least-busy",
    "openai_proxy_port": 4000,
    "openai_proxy_dir": "${GPU_CONTROL_GATEWAY_DIR}",
    "openai_proxy_role": "optional AI Gateway (LiteLLM)；装好/配置好后 gateway ensure 自动随入口启动",
    "extra_http_port": 8080,
    "extra_http_role": "optional extra HTTP service",
    "nginx_listen": 18080
  },
  "watchdog": {
    "enabled": true,
    "jobs": [],
    "interval_sec": 60,
    "max_restarts": 3,
    "nodes": "all",
    "failure_threshold": 2
  },
  "scheduling": {
    "prefer_labels": [
      "serving"
    ],
    "avoid_labels": [
      "shared"
    ],
    "unit_gpus": 4
  },
  "collaboration": {
    "mode": "horizontal-scale",
    "notes": [
      "control = CPU control-plane; nodes.* = GPU workers.",
      "Jobs are pluggable JSON + remote manager scripts — not tied to one model.",
      "Borrow a node: gpu-control free --node X --cordon"
    ]
  }
}

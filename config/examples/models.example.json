{
  "description": "模型目录 / 缓存 / 校验 / 拉取。path 可用 ${paths.*}。复制到 ../local/models.json",
  "caches": [
    {
      "id": "hf-hub",
      "path": "${paths.cache}",
      "note": "共享权重缓存根"
    }
  ],
  "models": [
    {
      "id": "example-model",
      "repo": "org/model-name",
      "path": "${paths.cache}/org/model-name",
      "cache": "hf-hub",
      "note": "登记后可用 models pull / verify；launch 可选",
      "launch": {
        "job": "shell-job",
        "runtime": "process",
        "extra_args": []
      },
      "verify": {
        "expect_files": ["config.json"],
        "min_bytes": 1000
      }
    }
  ],
  "pull": {
    "tool": "auto",
    "default_cache": "hf-hub",
    "hf_token_file": "config/local/secrets/hf_token",
    "modelscope_token_file": "config/local/secrets/modelscope_token"
  }
}

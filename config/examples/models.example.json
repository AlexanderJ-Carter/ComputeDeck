{
  "description": "模型目录 / 缓存 / 校验 / 拉取。path 可用 ${paths.*}。复制到 ../local/models.json",
  "caches": [
    {
      "id": "hf-hub",
      "path": "${paths.cache}",
      "note": "HF / 共享权重缓存根"
    }
  ],
  "models": [
    {
      "id": "decider-2b",
      "repo": "Mapika/decider-2b",
      "path": "${paths.model_root}/Mapika/decider-2b",
      "cache": "hf-hub",
      "note": "示例权重目录",
      "launch": {
        "job": "decider",
        "runtime": "process",
        "extra_args": ["--base-port", "30000"]
      },
      "verify": {
        "expect_files": ["config.json"],
        "min_bytes": 1000000
      }
    }
  ],
  "pull": {
    "tool": "auto",
    "default_cache": "hf-hub",
    "note": "auto = 优先 huggingface-cli，否则 modelscope"
  }
}

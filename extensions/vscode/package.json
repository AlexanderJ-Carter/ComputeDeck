{
  "name": "computedeck-vscode",
  "displayName": "%computedeck.displayName%",
  "description": "%computedeck.description%",
  "version": "1.3.3",
  "publisher": "computedeck",
  "license": "AGPL-3.0-only",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f766e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderJ-Carter/ComputeDeck"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "gpu",
    "cluster",
    "compute",
    "mcp",
    "vllm",
    "computedeck",
    "remote-ssh",
    "control-plane",
    "ansible"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onView:computedeck.cluster"
  ],
  "contributes": {
    "commands": [
      {
        "command": "computedeck.refresh",
        "title": "%computedeck.command.refresh%",
        "category": "%computedeck.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "computedeck.openWorkbench",
        "title": "%computedeck.command.openWorkbench%",
        "category": "%computedeck.category%",
        "icon": "$(window)"
      },
      {
        "command": "computedeck.openAccess",
        "title": "%computedeck.command.openAccess%",
        "category": "%computedeck.category%",
        "icon": "$(shield)"
      },
      {
        "command": "computedeck.openDashboard",
        "title": "%computedeck.command.openDashboard%",
        "category": "%computedeck.category%",
        "icon": "$(globe)"
      },
      {
        "command": "computedeck.openPage",
        "title": "%computedeck.command.openPage%",
        "category": "%computedeck.category%",
        "icon": "$(layout)"
      },
      {
        "command": "computedeck.openNotices",
        "title": "%computedeck.command.openNotices%",
        "category": "%computedeck.category%",
        "icon": "$(bell)"
      },
      {
        "command": "computedeck.openAssistant",
        "title": "%computedeck.command.openAssistant%",
        "category": "%computedeck.category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "computedeck.configureAssistant",
        "title": "%computedeck.command.configureAssistant%",
        "category": "%computedeck.category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "computedeck.openExternalBrowser",
        "title": "%computedeck.command.openExternalBrowser%",
        "category": "%computedeck.category%",
        "icon": "$(link-external)"
      },
      {
        "command": "computedeck.login",
        "title": "%computedeck.command.login%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.setToken",
        "title": "%computedeck.command.setToken%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.useLocalCredentials",
        "title": "%computedeck.command.useLocalCredentials%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.logout",
        "title": "%computedeck.command.logout%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.runDoctor",
        "title": "%computedeck.command.runDoctor%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.liveness",
        "title": "%computedeck.command.liveness%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.testSSH",
        "title": "%computedeck.command.testSSH%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.execPreset",
        "title": "%computedeck.command.execPreset%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.deployJob",
        "title": "%computedeck.command.deployJob%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.freeNode",
        "title": "%computedeck.command.freeNode%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.nodeMenu",
        "title": "%computedeck.command.nodeMenu%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.jobMenu",
        "title": "%computedeck.command.jobMenu%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.nodeTerminal",
        "title": "%computedeck.command.nodeTerminal%",
        "category": "%computedeck.category%",
        "icon": "$(terminal)"
      },
      {
        "command": "computedeck.nodePreset",
        "title": "%computedeck.command.nodePreset%",
        "category": "%computedeck.category%",
        "icon": "$(pulse)"
      },
      {
        "command": "computedeck.nodeFree",
        "title": "%computedeck.command.nodeFree%",
        "category": "%computedeck.category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "computedeck.nodeCordon",
        "title": "%computedeck.command.nodeCordon%",
        "category": "%computedeck.category%",
        "icon": "$(lock)"
      },
      {
        "command": "computedeck.jobStart",
        "title": "%computedeck.command.jobStart%",
        "category": "%computedeck.category%",
        "icon": "$(play)"
      },
      {
        "command": "computedeck.jobStop",
        "title": "%computedeck.command.jobStop%",
        "category": "%computedeck.category%",
        "icon": "$(stop)"
      },
      {
        "command": "computedeck.jobRestart",
        "title": "%computedeck.command.jobRestart%",
        "category": "%computedeck.category%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "computedeck.installMcp",
        "title": "%computedeck.command.installMcp%",
        "category": "%computedeck.category%"
      },
      {
        "command": "computedeck.openWalkthrough",
        "title": "%computedeck.command.openWalkthrough%",
        "category": "%computedeck.category%",
        "icon": "$(book)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "computedeck",
          "title": "%computedeck.view.container%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "computedeck": [
        {
          "id": "computedeck.cluster",
          "name": "%computedeck.view.cluster%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "computedeck.refresh",
          "when": "view == computedeck.cluster",
          "group": "navigation@1"
        },
        {
          "command": "computedeck.openWorkbench",
          "when": "view == computedeck.cluster",
          "group": "navigation@2"
        },
        {
          "command": "computedeck.openAccess",
          "when": "view == computedeck.cluster",
          "group": "navigation@3"
        },
        {
          "command": "computedeck.openDashboard",
          "when": "view == computedeck.cluster",
          "group": "navigation@4"
        },
        {
          "command": "computedeck.openWalkthrough",
          "when": "view == computedeck.cluster",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "computedeck.nodeTerminal",
          "when": "view == computedeck.cluster && viewItem =~ /^node/",
          "group": "inline@1"
        },
        {
          "command": "computedeck.nodePreset",
          "when": "view == computedeck.cluster && viewItem =~ /^node/",
          "group": "inline@2"
        },
        {
          "command": "computedeck.nodeFree",
          "when": "view == computedeck.cluster && viewItem =~ /^node/",
          "group": "inline@3"
        },
        {
          "command": "computedeck.jobStart",
          "when": "view == computedeck.cluster && viewItem == job",
          "group": "inline@1"
        },
        {
          "command": "computedeck.jobRestart",
          "when": "view == computedeck.cluster && viewItem == job",
          "group": "inline@2"
        },
        {
          "command": "computedeck.jobStop",
          "when": "view == computedeck.cluster && viewItem == job",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "computedeck.nodeMenu",
          "when": "false"
        },
        {
          "command": "computedeck.jobMenu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%computedeck.config.title%",
      "properties": {
        "computedeck.apiBase": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "%computedeck.config.apiBase%"
        },
        "computedeck.pollIntervalSec": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "%computedeck.config.pollIntervalSec%"
        },
        "computedeck.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%computedeck.config.statusBar%"
        },
        "computedeck.mcpPath": {
          "type": "string",
          "default": "${workspaceFolder}/bin/gpu-control-mcp",
          "description": "%computedeck.config.mcpPath%"
        },
        "computedeck.sshUser": {
          "type": "string",
          "default": "",
          "description": "%computedeck.config.sshUser%"
        },
        "computedeck.autoLocalAuth": {
          "type": "boolean",
          "default": true,
          "description": "%computedeck.config.autoLocalAuth%"
        },
        "computedeck.controlRoot": {
          "type": "string",
          "default": "",
          "description": "%computedeck.config.controlRoot%"
        },
        "computedeck.uiOpenMode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "access",
            "simpleBrowser",
            "embed",
            "external"
          ],
          "enumDescriptions": [
            "%computedeck.config.uiOpenMode.auto%",
            "%computedeck.config.uiOpenMode.access%",
            "%computedeck.config.uiOpenMode.simpleBrowser%",
            "%computedeck.config.uiOpenMode.embed%",
            "%computedeck.config.uiOpenMode.external%"
          ],
          "description": "%computedeck.config.uiOpenMode%"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "computedeck.mcp",
        "label": "%computedeck.mcp.label%"
      }
    ],
    "viewsWelcome": [
      {
        "view": "computedeck.cluster",
        "contents": "%computedeck.welcome.disconnected%",
        "when": "computedeck.disconnected"
      }
    ]
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --allow-missing-repository",
    "check": "node --check extension.js"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "需要执行本地 / SSH 运维命令，只在受信任的工作区启用。"
    }
  },
  "homepage": "https://compute.alexander.xin/",
  "bugs": {
    "url": "https://github.com/AlexanderJ-Carter/ComputeDeck/issues"
  },
  "pricing": "Free"
}

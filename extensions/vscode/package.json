{
  "name": "computedeck-vscode",
  "displayName": "ComputeDeck",
  "description": "ComputeDeck GPU control plane in VS Code: cluster tree, status bar, node/job actions, terminal, diagnostics and MCP.",
  "version": "1.2.7",
  "publisher": "computedeck",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderJ-Carter/ComputeDeck"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "gpu",
    "cluster",
    "compute",
    "mcp",
    "vllm",
    "computedeck"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:computedeck.cluster"
  ],
  "contributes": {
    "commands": [
      {
        "command": "computedeck.refresh",
        "title": "ComputeDeck: 刷新集群状态",
        "icon": "$(refresh)"
      },
      {
        "command": "computedeck.openDashboard",
        "title": "ComputeDeck: 打开 Web 控制面",
        "icon": "$(globe)"
      },
      {
        "command": "computedeck.login",
        "title": "ComputeDeck: 密码登录"
      },
      {
        "command": "computedeck.setToken",
        "title": "ComputeDeck: 设置 API Token"
      },
      {
        "command": "computedeck.logout",
        "title": "ComputeDeck: 退出登录"
      },
      {
        "command": "computedeck.runDoctor",
        "title": "ComputeDeck: 运行自检"
      },
      {
        "command": "computedeck.liveness",
        "title": "ComputeDeck: 节点探活"
      },
      {
        "command": "computedeck.testSSH",
        "title": "ComputeDeck: 测试 SSH"
      },
      {
        "command": "computedeck.execPreset",
        "title": "ComputeDeck: 运行只读诊断"
      },
      {
        "command": "computedeck.deployJob",
        "title": "ComputeDeck: 部署 Job"
      },
      {
        "command": "computedeck.freeNode",
        "title": "ComputeDeck: 腾空节点"
      },
      {
        "command": "computedeck.nodeMenu",
        "title": "节点操作"
      },
      {
        "command": "computedeck.jobMenu",
        "title": "Job 操作"
      },
      {
        "command": "computedeck.nodeTerminal",
        "title": "打开节点终端",
        "icon": "$(terminal)"
      },
      {
        "command": "computedeck.nodePreset",
        "title": "运行只读诊断",
        "icon": "$(pulse)"
      },
      {
        "command": "computedeck.nodeFree",
        "title": "腾空节点",
        "icon": "$(debug-stop)"
      },
      {
        "command": "computedeck.nodeCordon",
        "title": "隔离 / 恢复节点",
        "icon": "$(lock)"
      },
      {
        "command": "computedeck.jobStart",
        "title": "启动 Job",
        "icon": "$(play)"
      },
      {
        "command": "computedeck.jobStop",
        "title": "停止 Job",
        "icon": "$(stop)"
      },
      {
        "command": "computedeck.jobRestart",
        "title": "重启 Job",
        "icon": "$(debug-restart)"
      },
      {
        "command": "computedeck.installMcp",
        "title": "ComputeDeck: 注册 MCP Server"
      },
      {
        "command": "computedeck.openWalkthrough",
        "title": "ComputeDeck: 打开上手引导",
        "icon": "$(book)"
      }
    ],
    "walkthroughs": [
      {
        "id": "computedeck.getStarted",
        "title": "开始使用 ComputeDeck",
        "description": "连接控制面，读懂集群树，然后在 VS Code 里开终端、跑诊断、部署 Job。",
        "steps": [
          {
            "id": "connect",
            "title": "连接控制面",
            "description": "填写控制面地址并登录；Remote SSH 场景通常就是 127.0.0.1。\n[密码登录](command:computedeck.login)\n[设置 API Token](command:computedeck.setToken)",
            "media": {
              "markdown": "media/walkthrough/01-connect.md",
              "altText": "连接 ComputeDeck 控制面"
            },
            "completionEvents": [
              "onCommand:computedeck.login",
              "onCommand:computedeck.setToken",
              "onCommand:computedeck.refresh"
            ]
          },
          {
            "id": "cluster",
            "title": "读懂集群树",
            "description": "总览、节点、Job、队列租约、入口五个分区；状态栏常驻节点与空闲 GPU。",
            "media": {
              "markdown": "media/walkthrough/02-cluster.md",
              "altText": "ComputeDeck 集群树"
            },
            "completionEvents": [
              "onCommand:computedeck.refresh"
            ]
          },
          {
            "id": "nodes",
            "title": "节点终端与诊断",
            "description": "右键或行内按钮打开 SSH 终端、跑只读诊断、隔离或腾空节点。\n[节点操作](command:computedeck.nodeMenu)",
            "media": {
              "markdown": "media/walkthrough/03-nodes.md",
              "altText": "节点操作"
            },
            "completionEvents": [
              "onCommand:computedeck.nodeMenu",
              "onCommand:computedeck.nodeTerminal",
              "onCommand:computedeck.nodePreset"
            ]
          },
          {
            "id": "jobs",
            "title": "部署与启停 Job",
            "description": "按 GPU 数自动选节点，或指定节点部署；Job 行内可直接启动、重启、停止。\n[部署 Job](command:computedeck.deployJob)",
            "media": {
              "markdown": "media/walkthrough/04-jobs.md",
              "altText": "Job 操作"
            },
            "completionEvents": [
              "onCommand:computedeck.deployJob",
              "onCommand:computedeck.jobStart",
              "onCommand:computedeck.jobStop",
              "onCommand:computedeck.jobRestart"
            ]
          },
          {
            "id": "mcp",
            "title": "接入 Copilot 与 Web 看板",
            "description": "注册 MCP Server 后，Copilot / Claude 等 Agent 可直接调用 gc_* 工具；完整看板在浏览器。\n[注册 MCP Server](command:computedeck.installMcp)\n[打开 Web 控制面](command:computedeck.openDashboard)",
            "media": {
              "markdown": "media/walkthrough/05-mcp.md",
              "altText": "MCP 与 Web 看板"
            },
            "completionEvents": [
              "onCommand:computedeck.installMcp",
              "onCommand:computedeck.openDashboard"
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "computedeck",
          "title": "ComputeDeck",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "computedeck": [
        {
          "id": "computedeck.cluster",
          "name": "集群",
          "icon": "media/logo.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "computedeck.refresh",
          "when": "view == computedeck.cluster",
          "group": "navigation@1"
        },
        {
          "command": "computedeck.openDashboard",
          "when": "view == computedeck.cluster",
          "group": "navigation@2"
        },
        {
          "command": "computedeck.openWalkthrough",
          "when": "view == computedeck.cluster",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "computedeck.nodeTerminal",
          "when": "view == computedeck.cluster && viewItem =~ /^node/",
          "group": "inline@1"
        },
        {
          "command": "computedeck.nodePreset",
          "when": "view == computedeck.cluster && viewItem =~ /^node/",
          "group": "inline@2"
        },
        {
          "command": "computedeck.nodeFree",
          "when": "view == computedeck.cluster && viewItem =~ /^node/",
          "group": "inline@3"
        },
        {
          "command": "computedeck.jobStart",
          "when": "view == computedeck.cluster && viewItem == job",
          "group": "inline@1"
        },
        {
          "command": "computedeck.jobRestart",
          "when": "view == computedeck.cluster && viewItem == job",
          "group": "inline@2"
        },
        {
          "command": "computedeck.jobStop",
          "when": "view == computedeck.cluster && viewItem == job",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "computedeck.nodeMenu",
          "when": "false"
        },
        {
          "command": "computedeck.jobMenu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "ComputeDeck",
      "properties": {
        "computedeck.apiBase": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "ComputeDeck 控制面地址。VS Code Remote SSH 时可用 127.0.0.1；本机访问远端时填 SSH 隧道地址。"
        },
        "computedeck.pollIntervalSec": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "状态栏 / 集群树刷新间隔（秒）。"
        },
        "computedeck.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "在状态栏显示集群在线节点与 GPU 空闲数。"
        },
        "computedeck.mcpPath": {
          "type": "string",
          "default": "${workspaceFolder}/bin/gpu-control-mcp",
          "description": "gpu-control-mcp 可执行文件路径；用于向 VS Code / Copilot 注册 MCP Server。"
        },
        "computedeck.sshUser": {
          "type": "string",
          "default": "",
          "description": "节点终端默认 SSH 用户；留空则使用节点 ansible_user。"
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "computedeck.mcp",
        "label": "ComputeDeck"
      }
    ]
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --allow-missing-repository"
  }
}
